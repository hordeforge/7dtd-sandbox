# Safehouse container images. Two targets, because provisioning and running are
# different jobs with different dependencies:
#
#   fetch    steamcmd, for pulling the pristine bases into a bind-mounted
#            base/ without installing steamcmd on the host.
#   runtime  the client under Proton with the host's X11 socket and GPU.
#            No steamcmd, no Steam: that is the whole product claim, and an
#            image that ships a Steam provisioning toolchain it never invokes
#            contradicts it while carrying the supply chain anyway.
#
# Game trees and instances always stay on the host (bind mounts). Neither image
# contains game files: a 20 GB base does not belong in an image, and the
# depots are not ours to redistribute.
#
#   make docker            # runtime
#   make docker-fetch      # fetch
#   ./scripts/docker-gui.sh launch gamma
#   make fetch-server-base-docker   # fetch a base into ./base as your own user
#
# Known limitation, measured on this host: steamcmd installs fine to a path
# inside the container but fails on a plain bind mount with "Failed to install
# app ... (Missing configuration)" (identical image, user and command; only the
# mount mechanism differs). So the fetch targets mount base/ as a Docker local
# volume bound to this checkout's base/ rather than as `-v host:path`; make
# base-volume creates it and make fetch-server-base-docker uses it. Do not put
# steamcmd back into the runtime image to work around this.
#
# Bases are pinned by digest, not by a mutable tag, for the same reason the
# workflows pin actions by commit SHA: a moved tag is unreviewed code.

# One version home, and it is SB_VERSION in scripts/sb, not this file: `make
# docker` passes `sb version` in as a build arg. The default below is never the
# shipped version, so a direct `docker build` is visibly unversioned rather than
# quietly wrong. scripts/test_dockerfile.py holds the derivation.
ARG SB_VERSION=0.0.0-unset

# --- fetch: steamcmd only ---------------------------------------------------
FROM steamcmd/steamcmd@sha256:28633bf41a85592a50dc3aa2ca755be5510a4ba501bc34e28705b00ce7979574 AS fetch

ARG SB_VERSION

# sb shells out to sbconfig.py; python3 is also what steamcmd's wrapper uses.
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# sb runs `cd $SANDBOX_STEAMCMD && ./steamcmd.sh`, and steamcmd.sh resolves
# linux32/steamcmd relative to its own directory, so the whole directory has to
# be there (symlinking the script alone left it looking for
# /opt/steamcmd/linux32/steamcmd and every fetch died with "Couldn't find
# steamcmd").
#
# Symlinked, not copied. steamcmd resolves its Steam configuration from its
# installation directory's parent (.../Steam/steamcmd -> .../Steam), which the
# upstream image primed during build. Copying the program directory to /opt
# orphaned it from that tree and every app_update failed with the unhelpful
# "Failed to install app ... (Missing configuration)" after logging in fine.
RUN ln -sfn /root/.local/share/Steam/steamcmd /opt/steamcmd

COPY scripts/sb scripts/sbconfig.py /usr/local/bin/
RUN chmod 0755 /usr/local/bin/sb /usr/local/bin/sbconfig.py

# OCI labels: `docker image inspect` has to say which sb an image carries, and
# both images are pushed and pulled by a tag that says nothing else.
LABEL org.opencontainers.image.title="7dtd-safehouse (fetch)" \
      org.opencontainers.image.description="Provisions a pristine 7 Days to Die base with steamcmd" \
      org.opencontainers.image.source="https://github.com/hordeforge/7dtd-sandbox" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${SB_VERSION}"

WORKDIR /sandbox
# HOME is deliberately NOT overridden here. steamcmd keeps its Steam tree under
# $HOME, and the upstream image primed /root/.local/share/Steam during build.
# Pointing HOME at an empty directory gives steamcmd a fresh unprimed tree, and
# every app_update then fails with "Failed to install app ... (Missing
# configuration)" after logging in perfectly well. The runtime stage overrides
# HOME because Proton needs a writable one; this stage must not.
ENV SANDBOX_HOME=/sandbox \
    SANDBOX_STEAMCMD=/opt/steamcmd
ENTRYPOINT ["/usr/local/bin/sb"]
CMD ["help"]

# --- runtime: the client, no steamcmd --------------------------------------
FROM ubuntu@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517 AS runtime

ARG SB_VERSION

# python3 runs Proton's launcher and sb's own sbconfig.py; the rest is what
# DXVK/wine need to open an X11 window on /dev/dri (RADV on this host).
# Proton itself comes from the host's Steam tree, bind-mounted read-only by
# scripts/docker-gui.sh, so it is not installed here either.
# DEBIAN_FRONTEND is scoped to this instruction, not an image ENV: it configures
# apt, and an image-wide ENV lands in the environment of every process sb goes
# on to launch, Proton and the game included.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 \
        ca-certificates \
        libvulkan1 \
        mesa-vulkan-drivers \
        libgl1 \
        libgl1-mesa-dri \
        libasound2t64 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxext6 \
        libxrandr2 \
        libxcursor1 \
        libxi6 \
        libxinerama1 \
        libxxf86vm1 \
        libxkbcommon0 \
        libxcomposite1 \
        libxfixes3 \
        libxrender1 \
        libdbus-1-3 \
        libfreetype6 \
        libfontconfig1 \
        libgnutls30t64 \
        && rm -rf /var/lib/apt/lists/*

COPY scripts/sb scripts/sbconfig.py /usr/local/bin/
RUN chmod 0755 /usr/local/bin/sb /usr/local/bin/sbconfig.py

LABEL org.opencontainers.image.title="7dtd-safehouse (runtime)" \
      org.opencontainers.image.description="Steam-free 7 Days to Die client and server instances under Proton" \
      org.opencontainers.image.source="https://github.com/hordeforge/7dtd-sandbox" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${SB_VERSION}"

# Nothing in the runtime image needs root: sb and sbconfig.py are world
# executable, game trees live on the host, and scripts/docker-gui.sh already
# pins --user to the caller. /sandbox is the only path the image itself owns
# and sb writes instances under SANDBOX_HOME, so it is handed to this uid; a
# direct `docker run -v "$PWD:/sandbox"` with no --user still works.
#
# /tmp/sb-home is the HOME below, created here rather than left to the first
# process to want it: scripts/docker-gui.sh bind-mounts over it, but a direct
# `docker run` does not, and a HOME that does not exist is a wine/Proton launch
# that fails on a path the caller cannot see. /tmp is world-writable with the
# sticky bit, so it has to be this uid's own, or the container cannot write it.
RUN mkdir -p /sandbox /tmp/sb-home \
    && chown 1000:1000 /sandbox /tmp/sb-home
USER 1000:1000

WORKDIR /sandbox
# No SANDBOX_STEAMCMD: fetching is the `fetch` target's job, and sb refuses a
# fetch here by name rather than failing somewhere inside a missing directory.
ENV SANDBOX_HOME=/sandbox \
    STEAM_ROOT=/opt/steam \
    HOME=/tmp/sb-home

ENTRYPOINT ["/usr/local/bin/sb"]
CMD ["help"]
