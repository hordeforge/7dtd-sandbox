#!/usr/bin/env bash
# 7dtd-safehouse — isolated client and/or dedicated-server instances
#
# Three launch modes:
#   sb run client   <name> [-- game args]   - client only (Proton, no Steam)
#   sb run server   <name>                  - dedicated server only (native, app 294420)
#   sb run both     <name> [-- game args]   - both; client auto-connects to the server
#
# Underlying commands (still available):
#   create / create-server / launch / launch-server / stop / wipe / destroy /
#   list / status / logs / env / fetch-base / fetch-server-base / doctor / init
#
# Run `sb help` for the full list.
set -euo pipefail

SANDBOX_HOME="${SANDBOX_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
INSTANCES_DIR="${SANDBOX_INSTANCES:-$SANDBOX_HOME/instances}"
BASE_GAME="${SANDBOX_BASE_GAME:-$SANDBOX_HOME/base/game}"
SERVER_BASE_GAME="${SANDBOX_SERVER_BASE_GAME:-$SANDBOX_HOME/base/server-game}"
STEAMCMD_DIR="${SANDBOX_STEAMCMD:-$SANDBOX_HOME/tools/steamcmd}"
STEAM_APPID="${STEAM_APPID:-251570}"
SERVER_APPID="${SERVER_APPID:-294420}"
# Canonical version home for this repository (REPOSITORY_STANDARDS.md §8).
# The release workflow refuses a vX.Y.Z tag that disagrees with it.
SB_VERSION="0.3.0"
STEAM_ROOT="${STEAM_ROOT:-$HOME/.local/share/Steam}"
# Beside this script, not under SANDBOX_HOME: a caller may point
# SANDBOX_HOME at any instance root and sb must still find its own helper.
SB_CONFIG="${SB_CONFIG:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/sbconfig.py}"
# Interpreter for sbconfig.py, looked up on PATH: never a hardcoded
# /usr/bin/python3, because a venv, a pyenv shim or a distribution that ships
# python3.13 under that name is the ordinary case.
SB_PY="${SB_PY:-python3}"
# Oldest interpreter sbconfig.py supports, mirrored in its MIN_PYTHON and
# pinned equal by scripts/test_sb_cli.sh.
SB_PY_MIN="3.7"

die() { echo "sb: $*" >&2; exit 1; }
# Exit 2 for usage / missing-instance / bad-flag paths (test_sb_cli contract).
usage_err() { echo "sb: $*" >&2; exit 2; }
warn() { echo "sb: WARN: $*" >&2; }

usage() {
  cat <<'EOF'
Usage: sb <command> [args]

Standardized, isolated 7DTD client AND dedicated-server instances
(no Steam, no EOS, no Twitch).

Quick launch (three modes):
  run client <name> [-- args...]  client-only: Proton, no Steam (blocking)
  run server <name>               dedicated server only (blocking)
  run both   <name> [-- args...]  server + client; client auto-joins server

Underlying commands (full control):
  fetch-base [--validate | --seed-from-steam]
                       steamcmd-pull the pristine client (Windows depot forced)
  fetch-server-base [--validate]
                       steamcmd-pull the dedicated server (anonymous OK)
  create <name> [--res WxH] [--fullscreen 0|1]
                       fresh isolated client instance (game copy + Proton
                       prefix + its declared window; default windowed 1280x720)
  create-server <name> [--admin NAME...]
                       fresh isolated server instance (game copy + name-derived
                       port block + declared Local admins; NAME is [A-Za-z0-9._-])
  up <name> [--timeout N]       start the server detached, block until its
                       game port listens, then print the contract (stop: sb stop)
  stage <name> <mod-dir>...     copy built modlets into the instance's Mods
  render-config <name> KEY=VALUE...
                       declare serverconfig properties; the config is rebuilt
                       from the base template plus every declaration
                       (KEY is [A-Za-z][A-Za-z0-9_]*, VALUE is one line)
  launch <name> [-- args...]    run client under Proton, no Steam
  launch-server <name>          run dedicated server, blocking
  wipe <name> [name...] reset game/Mods/saves to pristine
  destroy <name> [name...]      remove instance entirely
  stop <name> [name...]         TERM/KILL only this instance's processes
  list                  list instances with running state
  status <name>         show one instance's state and paths
  logs <name> [-f]      tail the instance's log
  env <name>            eval-able contract for sibling harnesses
  doctor                report readiness
  version               print the sb version
  help                  this text

Standard env: SANDBOX_HOME, SANDBOX_INSTANCES, SANDBOX_BASE_GAME,
SANDBOX_SERVER_BASE_GAME, SANDBOX_STEAMCMD, STEAM_APPID, SERVER_APPID,
STEAM_ROOT, PROTON, GFX_API, SB_RES (default 1280x720),
SB_FULLSCREEN (default 0=windowed), SB_CONFIG, SB_PY (default python3, needs
3.7+), STEAMCMD_USER, 7DTD_PLAYER_NAME, STEAM_SEED_SOURCE, FASTCONNECT_DIST.

Host: Linux, bash, and that python3 on PATH (sb doctor reports both).

Credentials: STEAMCMD_USER is the account name; the password is never read
from the environment (it would have to reach steamcmd as an argument, which
the process table exposes). 'sb fetch-base' prompts for it on a terminal.
EOF
}

# --- detection -------------------------------------------------------------

# Every serverconfig render, admin seed and port derivation shells out to
# sbconfig.py, so an absent or too-old interpreter is not a bare
# `command not found` halfway through `sb create-server`. Checked where the
# interpreter is used, so `sb version` and `sb help` keep working without one.
require_python() {
  command -v "$SB_PY" >/dev/null 2>&1 \
    || die "$SB_PY not on PATH; sbconfig.py needs Python $SB_PY_MIN or newer"
  "$SB_PY" -c 'import sys; sys.exit(sys.version_info < tuple(int(p) for p in sys.argv[1].split(".")))' \
    "$SB_PY_MIN" 2>/dev/null \
    || die "$SB_PY is older than $SB_PY_MIN; sbconfig.py needs Python $SB_PY_MIN or newer"
}

detect_proton() {
  if [[ -n "${PROTON:-}" ]]; then
    [[ -x "$PROTON" ]] || die "PROTON set but not executable: $PROTON"
    echo "$PROTON"
    return 0
  fi
  local p
  for p in \
    "$STEAM_ROOT/steamapps/common/Proton - Experimental/proton" \
    "$STEAM_ROOT/steamapps/common/Proton 11.0/proton" \
    "$STEAM_ROOT/steamapps/common/Proton 10.0/proton" \
    "$HOME/.steam/steam/steamapps/common/Proton - Experimental/proton"
  do
    if [[ -x "$p" ]]; then echo "$p"; return 0; fi
  done
  die "no Proton found; set PROTON=/path/to/proton"
}

# --- instance plumbing -----------------------------------------------------

validate_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "invalid instance name '$1' (use [A-Za-z0-9._-], not starting with '-')"
}

# One declared value from an instance's instance.env, or empty. Every reader
# goes through here, so a key is looked up the same way everywhere: last
# declaration wins, a missing key reads as empty rather than as the comment
# lines that surround it. Last wins because that is what `sb env` hands the
# caller: it exports every declaration, so the shell's own last-one-wins
# settles a hand-edited duplicate before any reader of this file ever sees it.
instance_env_value() {
  sed -n "s/^$2=//p" "$1/instance.env" 2>/dev/null | tail -1
}

# One value as a single shell word, for the consumer that evaluates `sb env`.
# A quote in a path or a declared value stays inside the string instead of
# closing it and running whatever followed.
shquote() {
  local s="${1//\'/\'\\\'\'}"
  printf "'%s'" "$s"
}

# Steam only ever validates files it owns (inside a steamapps library). The
# sandbox's whole isolation story is that Steam neither owns nor touches base/
# or instances/, so a directory under any steamapps tree is refused here.
assert_not_steam_owned() {
  local path="$1" what="$2"
  local resolved cur
  if [[ -d "$path" ]]; then
    resolved="$(cd "$path" 2>/dev/null && pwd)" || resolved="$path"
  else
    resolved="$(cd "$(dirname "$path")" 2>/dev/null && pwd)/$(basename "$path")" || resolved="$path"
  fi
  case "$resolved" in
    */steamapps|*/steamapps/*)
      die "$what must not live inside a Steam library ($resolved); Steam would own and verify these files"
      ;;
  esac
  # SANDBOX_HOME may itself be a Steam library root (…/steamlib holding
  # steamapps/). A library is identified by steamapps/common, not by steamapps
  # alone: steamcmd writes its own steamapps/ (appmanifest, downloading, temp)
  # straight into whatever +force_install_dir it was given, so `base/game`
  # carries one after every fetch. Testing for the bare directory refused our
  # own pristine base.
  cur="$resolved"
  while [[ -n "$cur" && "$cur" != "/" ]]; do
    if [[ -d "$cur/steamapps/common" ]]; then
      die "$what must not live inside a Steam library ($resolved); Steam would own and verify these files"
    fi
    cur="$(dirname "$cur")"
  done
}

instance_dir() {
  validate_name "$1"
  local inst="$INSTANCES_DIR/$1"
  [[ -d "$inst" ]] || usage_err "instance '$1' not found (create it with 'sb create $1' or 'sb create-server $1')"
  echo "$inst"
}

copy_tree() {
  local src="$1" dst="$2" what="$3"
  # dst is always a fresh copy of src: any previous content (e.g. an empty
  # dir left by a failed fetch) is replaced. dst is a sandbox-owned path.
  rm -rf "$dst"
  if cp -a --reflink=always "$src" "$dst" 2>/dev/null; then
    return 0
  fi
  if cp -a --reflink=auto "$src" "$dst" 2>/dev/null; then
    warn "reflink unavailable, plain-copied $what (slower)"
    return 0
  fi
  die "could not copy $what from $src to $dst"
}

write_local_platform() {
  cat > "$1" <<'EOF'
platform=Local
crossplatform=None
serverplatforms=Steam,LAN,Local,
EOF
}

# A server instance keeps the stock platform surface (Steam listed first) but
# still admits Local joins, which is what the seeded admins authenticate with.
write_server_platform() {
  cat > "$1" <<'EOF'
platform=Steam
crossplatform=None
serverplatforms=Steam,LAN,Local,
EOF
}

ensure_local_platform() {
  local cfg="$1/platform.cfg"
  if [[ -f "$cfg" ]] && grep -q '^platform=Local' "$cfg"; then
    return 0
  fi
  write_local_platform "$cfg"
  echo "instance platform.cfg set to Local (no Steam auth, no EOS)"
}

# Always-admin for Local sandbox clients. Stock auth maps PltfmId
# `Local_<playername>` to platform="Local" userid=<playername>. Without a
# seed, Local joins land as permission 1000 and cannot run dm/givetools. The
# names are read back from this instance's own SERVER_ADMINS declaration, never
# discovered from whatever other instances exist on the machine. Idempotent:
# creates the file if missing, otherwise upserts a level-0 Local entry per
# declared name.
seed_sandbox_admins() {
  local inst="$1" declared name args=()
  declared="$(instance_env_value "$inst" SERVER_ADMINS)"
  # An instance created before SERVER_ADMINS existed still gets its pair name.
  [[ -n "$declared" ]] || declared="$(default_server_admins "$(basename "$inst")")"
  local IFS=,
  for name in $declared; do
    [[ -n "$name" ]] && args+=(--name "$name")
  done
  unset IFS
  require_python
  "$SB_PY" "$SB_CONFIG" seed-admins "$inst/userdata" "${args[@]}"
}


# Host-visible logs: the game writes C:/users/steamuser/AppData/Roaming/7DaysToDie/logs
# inside the prefix; replace that dir with a symlink to $inst/logs so harnesses
# read host paths. Re-run at every launch (idempotent).
link_prefix_logs() {
  local inst="$1"
  local pfxlog="$inst/compatdata/pfx/drive_c/users/steamuser/AppData/Roaming/7DaysToDie/logs"
  if [[ -d "$inst/compatdata/pfx" ]]; then
    mkdir -p "$(dirname "$pfxlog")"
    rm -rf "$pfxlog"
    ln -s "$inst/logs" "$pfxlog"
  fi
}

# Pids of processes bound to this instance: clients carry their unique
# STEAM_COMPAT_DATA_PATH; server instances carry SB_INSTANCE (set at launch).
# Never matches the steam client or other instances.
instance_pids() {
  local marker="$1" value="$2" ef pid
  for ef in /proc/[0-9]*/environ; do
    [[ -r "$ef" ]] || continue
    pid="${ef#/proc/}"; pid="${pid%/environ}"
    [[ "$pid" == "$$" || "$pid" == "$PPID" ]] && continue
    if { tr '\0' '\n' < "$ef"; } 2>/dev/null | grep -Fqx "$marker=$value"; then
      echo "$pid"
    fi
  done
}

# Instance kind: 'server' for server instances, 'client' otherwise.
instance_kind() {
  local inst="$1"
  if [[ -f "$inst/instance.env" ]] && grep -q '^SERVER_KIND=server' "$inst/instance.env"; then
    echo server
  else
    echo client
  fi
}

# Running pids for an instance of either kind.
instance_procs() {
  local inst="$1" kind
  kind="$(instance_kind "$inst")"
  if [[ "$kind" == server ]]; then
    instance_pids SB_INSTANCE "$inst"
  else
    instance_pids STEAM_COMPAT_DATA_PATH "$inst/compatdata"
  fi
}

# --- client commands -------------------------------------------------------

require_base() {
  [[ -d "$BASE_GAME" ]] || die "base game missing at $BASE_GAME (run 'sb fetch-base' first)"
  [[ -f "$BASE_GAME/7DaysToDie.exe" ]] || die "base game incomplete: no 7DaysToDie.exe in $BASE_GAME"
}

# Per-instance online-service opt-outs, written into the instance's own prefix
# registry so no instance ever phones home by default.
seed_offline_prefs() {
  local inst="$1"
  [[ -d "$inst/compatdata/pfx" ]] || return 0
  local proton
  proton="$(detect_proton)"
  local prefs="HKCU\\Software\\The Fun Pimps\\7 Days To Die"
  if ( cd "$inst/game" \
       && env STEAM_COMPAT_DATA_PATH="$inst/compatdata" \
              STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT" \
              "$proton" run reg.exe add "$prefs" /v "DiscordDisabled_h2080590481" /t REG_DWORD /d 1 /f >/dev/null 2>&1 ); then
    echo "offline prefs seeded: Discord disabled"
  else
    warn "could not seed Discord-off pref (online services stay at game defaults)"
  fi
}

# Fetching needs steamcmd; running does not. The runtime container ships none
# on purpose, so say which image does the job instead of failing inside a `cd`
# to a directory that was never there.
require_steamcmd() {
  [[ -x "$STEAMCMD_DIR/steamcmd.sh" ]] && return 0
  die "no steamcmd at $STEAMCMD_DIR/steamcmd.sh (set SANDBOX_STEAMCMD).
    Fetching a base is a provisioning job: run it on the host, or in the
    'fetch' image (docker build --target fetch -f Dockerfile.safehouse .).
    The runtime image ships no steamcmd by design."
}

# The app id goes straight to steamcmd's `app_update`, where a typo fetches
# whatever that number happens to be (or fails deep in the download), and it
# is also the SteamAppId the client launch exports. A non-numeric value is a
# misconfiguration, not something to discover mid-fetch.
require_appid() { # require_appid <appid> <name>
  if [[ ! "$1" =~ ^[1-9][0-9]*$ ]]; then
    die "$2 must be a Steam app id (got '$1')"
  fi
}

cmd_fetch() {
  # Steam verification off by default: -validate makes steamcmd hash-check
  # every file against the depot. The whole point of the sandbox is Steam
  # never owns these files; pass --validate to opt in.
  local validate=()
  case "${1:-}" in
    --validate) validate=(-validate); echo "sb: steam data-file validation enabled (--validate)" ;;
    --seed-from-steam) cmd_seed_from_steam; return 0 ;;
    "") ;;
    *) usage_err "unknown fetch-base option '$1' (--validate | --seed-from-steam)" ;;
  esac
  # steamcmd only takes a password as a `+login user pass` argument, and argv
  # is world-readable: every local user on the box could read the Steam
  # password off the process table for the length of the fetch. Refused before
  # anything else, rather than silently dropped, so an exported STEAMCMD_PASS
  # fails loudly instead of leaking (see SECURITY.md).
  if [[ -n "${STEAMCMD_PASS:-}" ]]; then
    usage_err "STEAMCMD_PASS is refused: steamcmd takes a password only as a command-line
    argument, which the process table exposes. Unset it and let steamcmd prompt
    ('sb fetch-base' in a terminal; 'make fetch-base-docker' allocates a TTY)."
  fi
  require_steamcmd
  require_appid "$STEAM_APPID" STEAM_APPID
  assert_not_steam_owned "$BASE_GAME" "base game"
  mkdir -p "$BASE_GAME"
  local login=(+login anonymous)
  if [[ -n "${STEAMCMD_USER:-}" ]]; then
    login=(+login "$STEAMCMD_USER")
    [[ -t 0 ]] || echo "sb: stdin is not a terminal; steamcmd cannot prompt for the password here." >&2
  else
    echo "sb: anonymous login; the 7DTD client (251570) needs a subscription, so this will" >&2
    echo "    fail with 'No subscription' unless the app is free. For a real account set" >&2
    echo "    STEAMCMD_USER, or run 'sb fetch-base' in a terminal and" >&2
    echo "    type the password when prompted." >&2
  fi
  if ! ( cd "$STEAMCMD_DIR" && ./steamcmd.sh +@sSteamCmdForcePlatformType windows \
      +force_install_dir "$BASE_GAME" "${login[@]}" \
      +app_update "$STEAM_APPID" "${validate[@]}" +quit ); then
    echo "sb: steamcmd exited nonzero (see its output above); for the paid client (251570) an" >&2
    echo "    anonymous login cannot work - set STEAMCMD_USER and retry." >&2
    exit 1
  fi
}

cmd_seed_from_steam() {
  local src="${STEAM_SEED_SOURCE:-$HOME/.local/share/Steam/steamapps/common/7 Days To Die}"
  [[ -f "$src/7DaysToDie.exe" ]] || die "seed source is not a 7DTD install: $src"
  assert_not_steam_owned "$BASE_GAME" "base game"
  if [[ -d "$BASE_GAME" && -f "$BASE_GAME/7DaysToDie.exe" ]]; then
    echo "sb: base already present at $BASE_GAME; delete it first to re-seed"
    return 1
  fi
  mkdir -p "$(dirname "$BASE_GAME")"
  echo "seeding base from $src (reflink snapshot; bootstrap only)"
  copy_tree "$src" "$BASE_GAME" "seed base"
  echo "seeded $(date -u +%Y-%m-%dT%H:%M:%SZ) from $src" > "$BASE_GAME/.seed-from-steam"
}

# --- server commands -------------------------------------------------------

cmd_fetch_server_base() {
  local validate=()
  case "${1:-}" in
    --validate) validate=(-validate); echo "sb: steam data-file validation enabled (--validate)" ;;
    "") ;;
    *) usage_err "unknown fetch-server-base option '$1' (--validate)" ;;
  esac
  require_steamcmd
  require_appid "$SERVER_APPID" SERVER_APPID
  assert_not_steam_owned "$SERVER_BASE_GAME" "server base game"
  mkdir -p "$SERVER_BASE_GAME"
  if ! ( cd "$STEAMCMD_DIR" && ./steamcmd.sh +force_install_dir "$SERVER_BASE_GAME" \
      +login anonymous +app_update "$SERVER_APPID" "${validate[@]}" +quit ); then
    echo "sb: steamcmd exited nonzero (see its output above)" >&2
    exit 1
  fi
}

# The instance's contiguous 5-port block, derived from its name: ServerPort
# (game, UDP+TCP), +1 telnet, +2..+4 spare (the dedicated opens a few ephemeral
# ports around ServerPort; loadgen bots also join on ServerPort+2).
#
# Name-derived, not creation-ordered: `srv-lab` gets the same ports on every
# machine whatever was created before it, so a harness that records a port can
# reproduce the run elsewhere. A block another instance already recorded is
# skipped by a deterministic forward probe.
alloc_server_ports() {
  require_python
  "$SB_PY" "$SB_CONFIG" port-block "$1" --instances "$INSTANCES_DIR"
}

# Local player names this server admits as permission_level=0. Declared once at
# create time and read back from instance.env, never discovered by scanning
# whatever other instances exist: the same declaration must produce the same
# serveradmin.xml on any host.
default_server_admins() {
  local name="$1"
  case "$name" in
    srv-*) echo "client-${name#srv-}" ;;
    *)     echo "" ;;
  esac
}

# A Local admin name reaches two destinations: serveradmin.xml (escaped) and
# instance.env (shell). instance.env is documented as source-able and `sb env`
# prints it for eval, so a name carrying shell metacharacters would be executed
# by the next harness. Charset-identical to an instance name, no exceptions.
validate_admin_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
    || usage_err "invalid admin name '$1' (use [A-Za-z0-9._-], not starting with '-')"
}

cmd_create_server() {
  # Shifted, so "$@" below is the --admin extras and not the instance name
  # itself: without this the server declared its own name as a Local admin.
  local name="$1"; shift || true
  validate_name "$name"
  [[ -d "$SERVER_BASE_GAME" && -f "$SERVER_BASE_GAME/7DaysToDieServer.x86_64" ]] \
    || die "server base missing at $SERVER_BASE_GAME (run 'sb fetch-server-base' first)"
  assert_not_steam_owned "$INSTANCES_DIR" "instances"
  local inst="$INSTANCES_DIR/$name"
  [[ -e "$inst" ]] && die "instance '$name' already exists at $inst"
  # Validated and assembled before the directory exists, so a refused name
  # exits 2 with nothing written rather than through the rollback below.
  local admins extra
  admins="$(default_server_admins "$name")"
  for extra in "$@"; do
    validate_admin_name "$extra"
    admins="${admins:+$admins,}$extra"
  done
  mkdir -p "$inst"
  # Everything past this point works on a directory nothing else has claimed
  # yet. A failure anywhere in it (a copy that ran out of space, a seeding
  # error) would otherwise leave an instance dir that refuses every retry with
  # "already exists" and has to be removed by hand. The subshell keeps `die`
  # from ending the whole run, so the rollback is reachable.
  if ! (
    set -e
    create_server_body "$inst" "$name" "$admins"
  ); then
    rm -rf "$inst"
    die "server instance '$name' was not created; the partial tree at $inst is removed"
  fi
  local port
  port="$(sed -n 's/^SERVER_PORT=//p' "$inst/instance.env" | head -1)"
  echo "server instance '$name' created at $inst (ports ${port}..$(( port + 4 )))"
}

# The body of cmd_create_server, run in a subshell so the caller can roll the
# instance directory back when any step of it fails.
create_server_body() {
  local inst="$1" name="$2" admins="$3"
  local port
  port="$(alloc_server_ports "$name")"
  echo "copying server base into instance (reflink/COW)..."
  copy_tree "$SERVER_BASE_GAME" "$inst/game" "server base game"
  prune_instance_mods "$inst"
  mkdir -p "$inst/userdata/Saves" "$inst/userdata/Logs" "$inst/logs"
  write_server_platform "$inst/game/platform.cfg"
  # Written before seeding and rendering: both read their declaration back
  # from this file, so the instance is described in one place.
  cat > "$inst/instance.env" <<EOF
# 7dtd-client-sandbox server instance contract (source or eval this file).
# Written by 'sb create-server'; consumed by 'sb launch-server' and siblings.
# SERVER_PORT is derived from SANDBOX_NAME, so the same name yields the same
# block on any machine. SERVER_ADMINS lists the Local player names this server
# admits at permission_level=0; edit it and relaunch to change them.
SANDBOX_NAME=$name
INSTANCE_DIR=$inst
SERVER_GAME=$inst/game
SERVER_USERDATA=$inst/userdata
SERVER_PORT=$port
SERVER_TELNET_PORT=$(( port + 1 ))
SERVER_CONFIG=$inst/serverconfig.xml
SERVER_PROPS=$inst/instance.props
SERVER_LOG=$inst/logs/server.log
SERVER_ADMINS=$admins
SERVER_KIND=server
EOF
  : > "$inst/instance.props"
  seed_sandbox_admins "$inst"
}

cmd_launch_server() {
  local name="$1"; shift || true
  local inst
  inst="$(instance_dir "$name")"
  [[ -f "$inst/instance.env" ]] || die "'$name' is not a server instance (missing instance.env)"
  grep -q '^SERVER_KIND=server' "$inst/instance.env" || die "'$name' is a client instance; use 'sb launch'"
  local game="$inst/game"
  instance_server_ports "$inst"
  local port="$SERVER_PORT" telnet_port="$SERVER_TELNET_PORT"
  mkdir -p "$inst/userdata/Saves" "$inst/userdata/Logs" "$inst/logs"
  local cfg
  apply_server_config "$inst" "$name" "$port" "$telnet_port"
  cfg="$APPLIED_CONFIG"
  seed_sandbox_admins "$inst"
  echo "sandbox:   $name (server)"
  echo "game:      $game"
  echo "port:      $port (telnet $telnet_port)"
  echo "userdata:  $inst/userdata"
  echo "log:       $inst/logs/server.log"
  cd "$game"
  exec env SB_INSTANCE="$inst" \
    LD_LIBRARY_PATH="$(collect_mods_native_path "$game")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
    ./7DaysToDieServer.x86_64 -configfile="$cfg" -logfile "$inst/logs/server.log" \
    -dedicated -nographics -batchmode "$@"
}


# Native libraries shipped inside modlets (<mod>/Native, the 7dtd-wasm bridge
# ships libwasmtime.so there). The Mono resolver only sees the loader search
# path captured at process start, so every server bring-up prepends each
# staged modlet's Native dir to LD_LIBRARY_PATH before exec. Derived from the
# instance's own Mods tree, never the caller's environment.
collect_mods_native_path() {
  local mods="$1/Mods" entry out=""
  [[ -d "$mods" ]] || return 0
  for entry in "$mods"/*/Native; do
    [[ -d "$entry" ]] || continue
    out="${out:+$out:}$entry"
  done
  printf '%s' "$out"
}

# Properties an instance owns. A caller may not declare these: the instance
# allocated the ports and owns the userdata path, and a serverconfig that
# disagrees would send every harness at a port the server never binds.
INSTANCE_OWNED_PROPS="ServerPort TelnetPort UserDataFolder"

# A declaration is KEY=VALUE, one line. The stock serverconfig names its
# properties [A-Za-z_][A-Za-z0-9_]*; anything else is a name the game never
# reads, and a key carrying a regex metacharacter also breaks the upsert that
# rewrites instance.props. A value with a line break would inject a second
# declaration, so it is refused at the point it is written rather than at the
# next launch, when the reason is a file and a line number nobody remembers.
validate_prop() { # validate_prop <KEY=VALUE> [where]
  local kv="$1" where="${2:-bad property}" key value
  [[ "$kv" == *=* ]] || usage_err "$where: '$kv' is not KEY=VALUE"
  key="${kv%%=*}"
  value="${kv#*=}"
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
    || usage_err "$where: key '$key' must match [A-Za-z_][A-Za-z0-9_]* (e.g. MaxSpawnedZombies=0)"
  case "$value" in
    *$'\n'*|*$'\r'*) usage_err "$where: the value of '$key' spans a line break; a declaration is one line" ;;
  esac
}

# The instance's port block, read from its own declaration. Both keys must be
# present, in range and adjacent: a config that disagrees with instance.env sends
# every harness at a port the server never binds, and a missing
# SERVER_TELNET_PORT leaves the dedicated with no telnet at all. Refused here,
# before the server is started, rather than by whatever the harness finds first.
instance_server_ports() { # instance_server_ports <inst>; sets SERVER_PORT and SERVER_TELNET_PORT
  local inst="$1"
  SERVER_PORT="$(sed -n 's/^SERVER_PORT=//p' "$inst/instance.env" | head -1)"
  SERVER_TELNET_PORT="$(sed -n 's/^SERVER_TELNET_PORT=//p' "$inst/instance.env" | head -1)"
  [[ "$SERVER_PORT" =~ ^[1-9][0-9]*$ ]] \
    || die "no valid SERVER_PORT in $inst/instance.env (recreate the instance)"
  (( SERVER_PORT <= 65535 )) \
    || die "SERVER_PORT=$SERVER_PORT is out of range in $inst/instance.env"
  [[ "$SERVER_TELNET_PORT" =~ ^[1-9][0-9]*$ ]] \
    || die "no valid SERVER_TELNET_PORT in $inst/instance.env (recreate the instance)"
  (( SERVER_TELNET_PORT == SERVER_PORT + 1 )) \
    || die "SERVER_TELNET_PORT=$SERVER_TELNET_PORT is not SERVER_PORT+1 in $inst/instance.env"
}

# Rebuild the instance serverconfig from the pristine base template plus the
# properties declared in instance.props. Rebuilt, never edited in place: an
# in-place edit accumulates, so a suite that sets MaxSpawnedZombies=0 would
# leave it set for the next suite that says nothing about spawns. Config is a
# pure function of (base template, declared props, instance identity).
#
# The rendered path is returned in APPLIED_CONFIG rather than on stdout: every
# caller wants it through a command substitution, and a refusal inside one
# would exit the subshell and hand the caller an empty path, which the server
# would then run with as `-configfile=`. That is the fail-open this shape
# exists to prevent.
#
# Shared by launch-server, `up` and `run both` so the bring-up paths cannot
# drift.
apply_server_config() {
  local inst="$1" name="$2" port="$3" telnet_port="$4"
  local cfg="$inst/serverconfig.xml"
  local args=() line lineno=0
  if [[ -f "$inst/instance.props" ]]; then
    # `|| [[ -n "$line" ]]`: instance.props is hand-editable, and a last line
    # with no trailing newline is a declaration read, not one dropped.
    while IFS= read -r line || [[ -n "$line" ]]; do
      lineno=$(( lineno + 1 ))
      [[ -z "$line" || "$line" == \#* ]] && continue
      validate_prop "$line" "$inst/instance.props:$lineno"
      args+=(--set "$line")
    done < "$inst/instance.props"
  fi
  # Instance-owned values go last so a declared property cannot win over them.
  require_python
  "$SB_PY" "$SB_CONFIG" render "$inst/game/serverconfig.xml" "$cfg" \
    --userdata "$inst/userdata" \
    "${args[@]}" \
    --set "ServerPort=$port" \
    --set "TelnetPort=$telnet_port" \
    --set "ServerName=sandbox-$name" \
    --set "EACEnabled=false" >/dev/null \
    || die "could not render $cfg from $inst/game/serverconfig.xml"
  APPLIED_CONFIG="$cfg"
}

# Record declared properties into instance.props (upsert by key, last write
# wins) so the next render includes them. Returns the file path.
#
# instance.props is a line format, so a value may not contain a newline: one
# would be read back as a second declaration, and the render would then fail
# on a fragment that is not KEY=VALUE. Refused here, at the point the caller
# can still see which key it was.
record_server_props() {
  local inst="$1"; shift
  local props="$inst/instance.props" kv key owned line
  touch "$props"
  for kv in "$@"; do
    validate_prop "$kv"
    key="${kv%%=*}"
    for owned in $INSTANCE_OWNED_PROPS; do
      [[ "$key" == "$owned" ]] && usage_err "$key is owned by the instance, not a caller (it allocated the ports and userdata path)"
    done
    # Upsert by literal prefix, read in the shell rather than through grep:
    # a key carrying `.`, `*` or `[` used to match (and drop) every other
    # declaration, losing the instance's whole declared state to one
    # `sb render-config` call. A newline in the value is refused by
    # validate_prop above: one declaration is one line.
    : > "$props.tmp"
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" == "$key="* ]] || printf '%s\n' "$line" >> "$props.tmp"
    done < "$props"
    printf '%s\n' "$kv" >> "$props.tmp"
    mv "$props.tmp" "$props"
  done
  sort -o "$props" "$props"
}

# --- commands --------------------------------------------------------------

cmd_init() {
  mkdir -p "$INSTANCES_DIR" "$SANDBOX_HOME/base"
  PROTON="$(detect_proton)"
  echo "SANDBOX_HOME=$SANDBOX_HOME"
  echo "INSTANCES_DIR=$INSTANCES_DIR"
  echo "BASE_GAME=$BASE_GAME"
  echo "PROTON=$PROTON"
  echo "STEAM_ROOT=$STEAM_ROOT"
  echo "steamcmd: $([ -x "$STEAMCMD_DIR/steamcmd.sh" ] && echo ok || echo missing)"
  # Readiness report, so a bad interpreter is named here rather than by the
  # first create/up that shells out to sbconfig.py.
  if command -v "$SB_PY" >/dev/null 2>&1; then
    echo "python:   $("$SB_PY" -V 2>&1) (need $SB_PY_MIN+)"
  else
    echo "python:   missing ($SB_PY not on PATH; need $SB_PY_MIN+)"
  fi
}

cmd_doctor() {
  cmd_init
  echo "--- client base ---"
  if [[ -d "$BASE_GAME" && -f "$BASE_GAME/7DaysToDie.exe" ]]; then
    du -sh "$BASE_GAME" 2>/dev/null || true
  else
    echo "client base missing; run 'sb fetch-base'"
  fi
  echo "--- server base ---"
  if [[ -d "$SERVER_BASE_GAME" && -f "$SERVER_BASE_GAME/7DaysToDieServer.x86_64" ]]; then
    du -sh "$SERVER_BASE_GAME" 2>/dev/null || true
  else
    echo "server base missing; run 'sb fetch-server-base'"
  fi
  echo "--- base mods ---"
  # A base seeded from a Steam install carries whatever that install had. An
  # instance prunes those, so a run is not broken by them, but a contaminated
  # base is still worth naming: it makes every fresh instance do that work, and
  # it means the base is not the pristine depot the isolation story claims.
  local b label
  for b in "$BASE_GAME:client" "$SERVER_BASE_GAME:server"; do
    label="${b##*:}"
    b="${b%%:*}"
    [[ -d "$b/Mods" ]] || continue
    local extra=() entry name
    for entry in "$b/Mods"/*; do
      [[ -e "$entry" ]] || continue
      name="$(basename "$entry")"
      is_stock_mod "$name" || extra+=("$name")
    done
    if (( ${#extra[@]} )); then
      echo "$label base ships: ${extra[*]}"
      echo "      instances prune these; a pair must run one mod set, and the two"
      echo "      depots ship different samples. Declare any you need as a staged mod."
    else
      echo "$label base: Harmony loader only"
    fi
  done
  echo "--- reflink ---"
  local probe="$SANDBOX_HOME/base/.reflink_probe"
  if cp --reflink=always "$BASE_GAME/7DaysToDie.exe" "$probe" 2>/dev/null; then
    echo "btrfs reflink available (cheap COW copies)"
  else
    echo "reflink unavailable (instances will be plain copies)"
  fi
  rm -f "$probe"
  echo "--- platform.cfg in client base ---"
  [[ -f "$BASE_GAME/platform.cfg" ]] && cat "$BASE_GAME/platform.cfg"
  echo "--- steam ownership guard ---"
  assert_not_steam_owned "$BASE_GAME" "client base" && echo "client base: not Steam-owned (Steam will never verify it)"
  assert_not_steam_owned "$SERVER_BASE_GAME" "server base" && echo "server base: not Steam-owned (Steam will never verify it)"
  assert_not_steam_owned "$INSTANCES_DIR" "instances" && echo "instances: not Steam-owned (Steam will never verify them)"
}

cmd_create() {
  local name="$1"; shift || true
  local res="${SB_RES:-1280x720}" fullscreen="${SB_FULLSCREEN:-0}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --res) shift; [[ $# -gt 0 ]] || usage_err "--res needs WIDTHxHEIGHT"; res="$1" ;;
      --fullscreen) shift; [[ $# -gt 0 ]] || usage_err "--fullscreen needs 0 or 1"; fullscreen="$1" ;;
      *) usage_err "unknown create option '$1' (--res WxH | --fullscreen 0|1)" ;;
    esac
    shift
  done
  validate_window "$res" "$fullscreen"
  validate_name "$name"
  require_base
  assert_not_steam_owned "$INSTANCES_DIR" "instances"
  assert_not_steam_owned "$BASE_GAME" "base game"
  local inst="$INSTANCES_DIR/$name"
  [[ -e "$inst" ]] && die "instance '$name' already exists at $inst"
  PROTON="$(detect_proton)"
  mkdir -p "$inst"
  # Rolled back on failure for the same reason as create_server: a half-built
  # instance dir refuses every retry with "already exists".
  if ! (
    set -e
    create_client_body "$inst" "$name" "$res" "$fullscreen"
  ); then
    rm -rf "$inst"
    die "instance '$name' was not created; the partial tree at $inst is removed"
  fi
  echo "created instance '$name' at $inst"
}

# The body of cmd_create, run in a subshell so the caller can roll the instance
# directory back when any step of it fails.
create_client_body() {
  local inst="$1" name="$2" res="$3" fullscreen="$4"
  echo "copying base game into instance (reflink/COW)..."
  copy_tree "$BASE_GAME" "$inst/game" "base game"
  prune_instance_mods "$inst"
  write_local_platform "$inst/game/platform.cfg"
  mkdir -p "$inst/compatdata" "$inst/logs"
  cat > "$inst/instance.env" <<EOF
# 7dtd-client-sandbox instance contract (source or eval this file).
# Written by 'sb create'; consumed by 'sb launch' and sibling harnesses.
# SB_RES / SB_FULLSCREEN are this instance's window, declared here rather than
# read from the caller's environment, so the same instance opens the same
# window on any machine. Edit them and relaunch to change it.
SANDBOX_NAME=$name
INSTANCE_DIR=$inst
GAME=$inst/game
COMPAT=$inst/compatdata
PROTON=$PROTON
STEAM_ROOT=$STEAM_ROOT
STEAM_APPID=$STEAM_APPID
LOGFILE=$inst/logs/output_log_client.txt
SB_RES=$res
SB_FULLSCREEN=$fullscreen
EOF
  echo "initializing Proton prefix (first run; one-time cost)..."
  if ( cd "$inst/game" \
       && env STEAM_COMPAT_DATA_PATH="$inst/compatdata" \
              STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT" \
              "$PROTON" run wineboot.exe -u >/dev/null 2>&1 ); then
    echo "prefix initialized"
  else
    warn "wineboot init failed; the prefix will be created on first 'sb launch'"
  fi
  seed_offline_prefs "$inst"
  link_prefix_logs "$inst"
}

# TERM, then KILL whatever is still standing, for every process bound to this
# instance. The one teardown every path shares: `stop`, `destroy`, and the
# bring-up paths that must not abandon a server they started. Nothing else
# matches by pattern, so one instance's teardown never touches another's.
terminate_instance() {
  local inst="$1"
  local pids
  mapfile -t pids < <(instance_procs "$inst")
  (( ${#pids[@]} )) || return 0
  echo "stopping instance (pids: ${pids[*]})"
  kill -TERM "${pids[@]}" 2>/dev/null || true
  sleep 3
  mapfile -t pids < <(instance_procs "$inst")
  if (( ${#pids[@]} > 0 )); then
    echo "still alive, sending KILL: ${pids[*]}"
    kill -KILL "${pids[@]}" 2>/dev/null || true
  fi
}

cmd_destroy() {
  local name="$1" inst
  inst="$(instance_dir "$name")"
  if [[ -n "$(instance_procs "$inst")" ]]; then
    echo "sb: instance '$name' is running; stopping it first"
    terminate_instance "$inst"
  fi
  rm -rf "$inst"
  echo "destroyed instance '$name'"
}

cmd_wipe() {
  local name="$1" inst kind
  inst="$(instance_dir "$name")"
  kind="$(instance_kind "$inst")"
  local pids
  pids="$(instance_procs "$inst")"
  if [[ -n "$pids" ]]; then
    die "instance '$name' is running (pids: $(echo "$pids" | tr '\n' ' ')); stop it first ('sb stop $name')"
  fi
  if [[ "$kind" == server ]]; then
    [[ -f "$SERVER_BASE_GAME/7DaysToDieServer.x86_64" ]] || die "server base missing (run 'sb fetch-server-base')"
    rm -rf "$inst/game"
    copy_tree "$SERVER_BASE_GAME" "$inst/game" "server base game"
    prune_instance_mods "$inst"
    write_server_platform "$inst/game/platform.cfg"
    rm -rf "$inst/userdata"
    mkdir -p "$inst/userdata/Saves" "$inst/userdata/Logs"
    seed_sandbox_admins "$inst"
    # The declared properties go with the state they configured: a wiped
    # instance is the base template again, not the last suite's world.
    rm -f "$inst/serverconfig.xml"
    : > "$inst/instance.props"
    echo "wiped server instance '$name': game, Mods, userdata and declared config reset to base"
    return 0
  fi
  require_base
  rm -rf "$inst/game"
  copy_tree "$BASE_GAME" "$inst/game" "base game"
  prune_instance_mods "$inst"
  write_local_platform "$inst/game/platform.cfg"
  seed_offline_prefs "$inst"
  local roam="$inst/compatdata/pfx/drive_c/users/steamuser/AppData/Roaming/7DaysToDie"
  rm -rf "$roam/Saves" "$roam/SavesLocal" "$roam/GeneratedWorlds" 2>/dev/null || true
  echo "wiped instance '$name': game, Mods and saves reset to pristine base"
}

instance_running() {
  local inst="$1"
  local pids
  pids="$(instance_procs "$inst")"
  [[ -n "$pids" ]] && echo "yes ($(echo "$pids" | wc -w) procs)" || echo "no"
}

cmd_list() {
  [[ -d "$INSTANCES_DIR" ]] || { echo "(no instances; run 'sb create <name>')"; return 0; }
  local d name running kind
  for d in "$INSTANCES_DIR"/*/; do
    [[ -d "$d" ]] || continue
    d="${d%/}"
    name="$(basename "$d")"
    kind="$(instance_kind "$d")"
    running="$(instance_running "$d")"
    printf '%-20s %-8s %-16s %s\n' "$name" "$kind" "$running" "$d"
  done
}

cmd_status() {
  local name="$1" inst kind
  inst="$(instance_dir "$name")"
  kind="$(instance_kind "$inst")"
  echo "instance:   $name ($kind)"
  echo "dir:        $inst"
  echo "running:    $(instance_running "$inst")"
  echo "game:       $inst/game  ($(du -sh "$inst/game" 2>/dev/null | cut -f1))"
  if [[ "$kind" == server ]]; then
    echo "userdata:   $inst/userdata"
    echo "log:        $inst/logs/server.log"
    echo "mods:       $inst/game/Mods"
  else
    echo "compatdata: $inst/compatdata"
    echo "log:        $inst/logs/output_log_client.txt"
    echo "mods:       $inst/game/Mods"
  fi
  echo "--- instance.env ---"
  cat "$inst/instance.env" 2>/dev/null || true
}

# Single-quote for eval: an unquoted path with a space or a glob would re-split
# when a caller runs the documented `eval "$(sb env <name>)"`.
shell_quote() {
  local s="$1"
  printf "'%s'" "${s//\'/\'\\\'\'}"
}

# Every line of the contract, for both instance kinds. A bare `KEY=value` line
# defines a shell variable but does not export it, so a server contract read
# this way was invisible to every child process a sibling harness spawned.
emit_env() {
  local kv key value
  for kv in "$@"; do
    key="${kv%%=*}"
    value="${kv#*=}"
    if [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      printf 'export %s=%s\n' "$key" "$(shell_quote "$value")"
    else
      printf 'export %s=%s\n' "$(shell_quote "$key")" "$(shell_quote "$value")"
    fi
  done
}

cmd_env() {
  local name="$1" inst kind
  inst="$(instance_dir "$name")"
  kind="$(instance_kind "$inst")"
  # Every value below is emitted as a quoted shell assignment, never echoed
  # raw: the documented consumer is `eval "$(sb env <name>)"`, so a line
  # carrying a quote or a command substitution would run in the caller's shell.
  if [[ "$kind" == server ]]; then
    local key value line
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -z "$line" || "$line" == \#* ]] && continue
      [[ "$line" == *=* ]] || continue
      key="${line%%=*}"; value="${line#*=}"
      [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      printf 'export %s=%s\n' "$key" "$(shquote "$value")"
    done < "$inst/instance.env"
    return 0
  fi
  PROTON="$(detect_proton)"
  # Read and validated here rather than in a command substitution: a refusal
  # must exit `sb` itself, not a subshell, which would hand the caller a client
  # with no window arguments at all.
  local res fullscreen win_args
  read -r res fullscreen < <(declared_window "$inst")
  validate_window "$res" "$fullscreen"
  win_args="$(screen_args "$res" "$fullscreen")"
  printf 'export SANDBOX_NAME=%s\n' "$(shquote "$name")"
  printf 'export INSTANCE_DIR=%s\n' "$(shquote "$inst")"
  printf 'export GAME=%s\n' "$(shquote "$inst/game")"
  printf 'export COMPAT=%s\n' "$(shquote "$inst/compatdata")"
  printf 'export PROTON=%s\n' "$(shquote "$PROTON")"
  printf 'export STEAM_ROOT=%s\n' "$(shquote "$STEAM_ROOT")"
  printf 'export STEAM_APPID=%s\n' "$(shquote "$STEAM_APPID")"
  printf 'export LOGFILE=%s\n' "$(shquote "$inst/logs/output_log_client.txt")"
  printf 'export SB_RES=%s\n' "$(shquote "$res")"
  printf 'export SB_FULLSCREEN=%s\n' "$(shquote "$fullscreen")"
  printf 'export SB_SCREEN_ARGS=%s\n' "$(shquote "$win_args")"
}

cmd_launch() {
  local name="$1"; shift || true
  local inst
  inst="$(instance_dir "$name")"
  if [[ "$(instance_kind "$inst")" == server ]]; then
    die "'$name' is a server instance; use 'sb launch-server $name'"
  fi
  local game="$inst/game" compat="$inst/compatdata"
  [[ -d "$game" ]] || die "instance '$name' game missing at $game (recreate or wipe)"
  PROTON="$(detect_proton)"
  ensure_local_platform "$game"
  mkdir -p "$inst/logs"
  link_prefix_logs "$inst"
  export STEAM_COMPAT_DATA_PATH="$compat"
  export STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT"
  export SteamAppId="$STEAM_APPID"
  export SteamGameId="$STEAM_APPID"
  local player
  player="$(printenv 7DTD_PLAYER_NAME 2>/dev/null || true)"
  [[ -n "$player" ]] || player="$name"
  local gfx_api="${GFX_API:-d3d11}"
  local gfx
  case "$gfx_api" in
    d3d11|d3d12|vulkan|glcore) gfx=(-force-"$gfx_api") ;;
    none) gfx=() ;;
    *) die "GFX_API must be d3d11, d3d12, vulkan, glcore or none (got '$gfx_api')" ;;
  esac
  local win_args=()
  if ! has_screen_arg "$@"; then
    local res fullscreen
    read -r res fullscreen < <(declared_window "$inst")
    validate_window "$res" "$fullscreen"
    read -r -a win_args < <(screen_args "$res" "$fullscreen")
  fi
  # The prefix's logs dir is a symlink to $inst/logs (link_prefix_logs), so
  # this name is the host path instance.env declares as LOGFILE and the one
  # `sb logs`, `sb status` and a sibling harness reading $LOGFILE look for.
  local win_log="C:/users/steamuser/AppData/Roaming/7DaysToDie/logs/output_log_client.txt"
  echo "sandbox:   $name"
  echo "proton:    $PROTON"
  echo "game:      $game"
  echo "compat:    $compat"
  echo "log:       $inst/logs/output_log_client.txt"
  echo "player:    $player"
  echo "window:    ${win_args[*]:-<as passed>}"
  cd "$game"
  exec env 7DTD_PLAYER_NAME="$player" "$PROTON" run ./7DaysToDie.exe "${gfx[@]}" -nogs -noeac -skipintro -SkipNewsScreen=true \
    -logfile "$win_log" "${win_args[@]}" "$@"
}

cmd_stop() {
  local name="$1" inst
  validate_name "$name"
  inst="$INSTANCES_DIR/$name"
  if [[ ! -d "$inst" ]]; then
    echo "sb: instance '$name' is not running"
    return 0
  fi
  local pids
  mapfile -t pids < <(instance_procs "$inst")
  if [[ ${#pids[@]} -eq 0 ]]; then
    echo "sb: instance '$name' is not running"
    return 0
  fi
  echo "stopping instance '$name'"
  terminate_instance "$inst"
  echo "stopped"
}

cmd_logs() {
  local name="$1" inst kind
  inst="$(instance_dir "$name")"
  kind="$(instance_kind "$inst")"
  local logfile
  if [[ "$kind" == server ]]; then
    logfile="$inst/logs/server.log"
  else
    logfile="$inst/logs/output_log_client.txt"
  fi
  [[ -f "$logfile" ]] || die "no log yet at $logfile"
  if [[ "${2:-}" == "-f" ]]; then
    tail -f "$logfile"
  else
    tail -n 40 "$logfile"
  fi
}

# --- run: three-mode dispatcher -------------------------------------------

# A sandbox client is a test fixture, not a game session: it must never take
# the display fullscreen, and several of them have to be visible at once. The
# command line wins over whatever the prefix's saved prefs hold, which is why
# the window is passed at every launch rather than seeded into the registry,
# and `sb env` exports it so a launcher that is not `sb launch`
# (7dtd-fastconnect's launch_client.sh, used by 7dtd-playtest) applies the same
# window. A malformed declaration is a refusal, never a client with no window
# arguments.
validate_window() {
  local res="$1" fullscreen="$2"
  [[ "$res" =~ ^[0-9]+x[0-9]+$ ]] || die "SB_RES must look like 1920x1080 (got '$res')"
  case "$fullscreen" in 0|1) ;; *) die "SB_FULLSCREEN must be 0 or 1 (got '$fullscreen')" ;; esac
}

# True when the caller's game args already carry a -screen-* argument, so the
# declared window is not added on top. A bash scan rather than
# `printf '%s\0' | grep -z`: NUL-separated input is a GNU extension, and a
# client launch should not be the one path that needs it.
has_screen_arg() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      *-screen-*) return 0 ;;
    esac
  done
  return 1
}

# The window this instance declared, as "<res> <fullscreen>". Read from its
# instance.env, not from the caller's environment: the same instance must open
# the same window on any machine. An instance created before the window was
# declared falls back to the defaults, which is what it was getting anyway.
# Pure: the caller validates, so a refusal exits `sb` rather than a subshell.
declared_window() {
  local inst="$1" res fullscreen default_res=1280x720 default_fullscreen=0
  res="$(instance_env_value "$inst" SB_RES)"
  fullscreen="$(instance_env_value "$inst" SB_FULLSCREEN)"
  [[ -n "$res" ]] || res="$default_res"
  [[ -n "$fullscreen" ]] || fullscreen="$default_fullscreen"
  echo "$res $fullscreen"
}

# The Unity window arguments every sandbox client launches with: windowed at
# the declared SB_RES (default 1280x720) unless SB_FULLSCREEN=1.
screen_args() {
  echo "-screen-fullscreen $2 -screen-width ${1%%x*} -screen-height ${1##*x}"
}

# The only mod an instance keeps unconditionally: the Harmony loader every code
# mod needs (workspace rule: code mods require stock 0_TFP_Harmony).
#
# TFP's sample modlets are deliberately NOT kept. The client and dedicated
# depots ship different ones (the server carries TFP_CommandExtensions and
# Xample_MarkersMod; the client carries neither), so keeping them makes every
# client/server pair asymmetric by construction: the server registers content
# the client never loaded, and the first world package it sends is unparseable.
# A suite that wants one names it in its mods list like any other.
STOCK_MOD_GLOBS='0_TFP_Harmony'

# True when a Mods entry is stock, that is the one loader an instance always
# keeps. `sb doctor` reports the same set it prunes, so the two cannot drift
# into disagreeing about what "stock" means.
is_stock_mod() {
  local name="$1" pattern
  # shellcheck disable=SC2086 # STOCK_MOD_GLOBS is a deliberate glob list
  for pattern in $STOCK_MOD_GLOBS; do
    # shellcheck disable=SC2053 # pattern is a glob, not a literal
    [[ "$name" == $pattern ]] && return 0
  done
  return 1
}

# An instance's Mods are the Harmony loader plus exactly what was declared.
#
# A base seeded from a Steam install carries whatever that install had. This
# repo's own client base carries RealEarth, so every client instance inherited
# a terrain mod the server instance did not: the pair registered different
# blocks, the client failed to deserialize the first world package and the
# server kicked it, minutes into a run, with nothing naming the cause.
#
# Pruning happens in the instance, never in the base (rule 1): the base stays
# the pristine depot copy, and what an instance runs stays a pure function of
# the depot's stock mods and the declaration.
prune_instance_mods() {
  local inst="$1" mods="$1/game/Mods" entry base removed=()
  [[ -d "$mods" ]] || return 0
  for entry in "$mods"/*; do
    [[ -e "$entry" ]] || continue
    base="$(basename "$entry")"
    is_stock_mod "$base" && continue
    rm -rf "$entry"
    removed+=("$base")
  done
  if (( ${#removed[@]} )); then
    echo "pruned undeclared mods: ${removed[*]}"
    echo "  (the base itself is untouched; stage what this instance needs)"
  fi
}

# Copy built modlets into an instance's game/Mods. Real copies, never
# symlinks: an instance is a self-contained tree, and a symlinked mod would
# make `sb wipe` and the base copy lie about what the instance runs.
stage_mods() {
  local inst="$1"; shift
  local src base
  mkdir -p "$inst/game/Mods"
  for src in "$@"; do
    [[ -d "$src" ]] || die "mod source is not a directory: $src"
    [[ -f "$src/ModInfo.xml" ]] || die "not a modlet (no ModInfo.xml): $src"
    base="$(basename "$src")"
    rm -rf "$inst/game/Mods/$base"
    cp -a "$src" "$inst/game/Mods/$base"
    echo "staged $base into $inst/game/Mods"
  done
}

# The sibling 7dtd-fastconnect client mod, so `sb run both` can auto-join (the
# stock client ignores -connect=). A note instead of a failure when the sibling
# repo or its dist/ is absent: the client still launches and sits at the menu.
stage_fastconnect() {
  local inst="$1"
  local src="${FASTCONNECT_DIST:-$SANDBOX_HOME/../7dtd-fastconnect/dist/7dtd-fastconnect}"
  if [[ -f "$src/ModInfo.xml" ]]; then
    stage_mods "$inst" "$src"
  else
    warn "7dtd-fastconnect dist not found at $src; client will sit at the menu (no auto-join)"
  fi
}

# Start a server instance detached (its own session), config already rendered.
# Shared by `sb up` and `sb run both` so the detached path exists once.
start_server_detached() {
  local inst="$1" name="$2" port="$3" telnet_port="$4"
  local cfg
  mkdir -p "$inst/userdata/Saves" "$inst/userdata/Logs" "$inst/logs"
  # Truncated per start: the game rotates its own server.log, but this capture
  # is the sandbox's, and a suite that brings the same instance up hundreds of
  # times would grow it without bound. One start's output per file.
  : > "$inst/logs/server.stdout.log"
  apply_server_config "$inst" "$name" "$port" "$telnet_port"
  cfg="$APPLIED_CONFIG"
  seed_sandbox_admins "$inst"
  # `setsid --fork` (not a backgrounded `setsid ... &`): setsid forks the
  # server into a new session and exits immediately, so the server is orphaned
  # to init and this shell has no child left to wait on. Backgrounding it
  # instead left the server parented to `sb`, and `sb up` then sat in do_wait
  # forever after its port check had already passed. `sb run both` never saw
  # this because it execs the client over itself straight afterwards.
  ( cd "$inst/game" \
    && exec setsid --fork env SB_INSTANCE="$inst" \
         LD_LIBRARY_PATH="$(collect_mods_native_path "$inst/game")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
         ./7DaysToDieServer.x86_64 \
           -configfile="$cfg" -logfile "$inst/logs/server.log" \
           -dedicated -nographics -batchmode \
        </dev/null >"$inst/logs/server.stdout.log" 2>&1 )
}

# Whole seconds since boot, read from the kernel. A deadline taken from the
# wall clock is not a duration: an NTP step forward ends the wait early, a
# step backward extends it by the size of the step, and neither is the
# --timeout the caller asked for. /proc/uptime counts uptime, is already a
# dependency of this script (instance_procs walks /proc/<pid>/environ), and
# truncating to whole seconds cancels out between the two readings of one wait.
monotonic_now() {
  local uptime
  read -r uptime _ </proc/uptime || die "cannot read /proc/uptime (needed for a monotonic timeout)"
  printf '%s' "${uptime%%.*}"
}

# Block until a TCP port accepts connections, or die after a timeout. The
# server logs "Telnet on <port>" and starts listening on <port>+0 well
# before the world is fully generated; clients that auto-join usually finish
# loading by then too.
wait_for_port() {
  local host="$1" port="$2" timeout="${3:-90}"
  local start
  start="$(monotonic_now)"
  while (( $(monotonic_now) - start < timeout )); do
    # The connection is opened in a subshell, so the socket closes with it.
    if (exec 3<>/dev/tcp/"$host"/"$port") 2>/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}

# Bring a server instance up detached and block until its game port accepts
# connections. `sb run server` execs and blocks forever; harnesses need a
# bounded, exit-coded bring-up they can call and then drive. Teardown is
# `sb stop <name>` (same instance-scoped process match as every other path).
cmd_up() {
  local name="$1"; shift || true
  local timeout=180
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) shift; [[ $# -gt 0 ]] || usage_err "--timeout needs a value"; timeout="$1" ;;
      *) usage_err "unknown up option '$1' (--timeout N)" ;;
    esac
    shift
  done
  [[ "$timeout" =~ ^[0-9]+$ ]] || usage_err "--timeout must be a whole number of seconds"
  validate_name "$name"
  [[ -d "$INSTANCES_DIR/$name" ]] || cmd_create_server "$name" >/dev/null
  local inst="$INSTANCES_DIR/$name"
  [[ -f "$inst/instance.env" ]] || die "'$name' is not a server instance (missing instance.env)"
  grep -q '^SERVER_KIND=server' "$inst/instance.env" || die "'$name' is a client instance; use 'sb launch'"
  local pids
  pids="$(instance_procs "$inst")"
  [[ -n "$pids" ]] && die "instance '$name' is already running (pids: $(echo "$pids" | tr '\n' ' '))"
  instance_server_ports "$inst"
  local port="$SERVER_PORT" telnet_port="$SERVER_TELNET_PORT"
  start_server_detached "$inst" "$name" "$port" "$telnet_port"
  if ! wait_for_port 127.0.0.1 "$port" "$timeout"; then
    # A server that never bound is still running and still holds its port
    # block. Stopping it here is what keeps a failed bring-up from leaving one
    # behind per attempt: a harness retrying against a wedged instance would
    # otherwise pile up servers, each owning a world and a userdata tree.
    echo "sb: bring-up failed, stopping the server it started" >&2
    terminate_instance "$inst"
    die "server '$name' did not open port $port in ${timeout}s; check $inst/logs/server.log"
  fi
  echo "server '$name' up on port $port (telnet $telnet_port)"
  cmd_env "$name"
}

# Copy built modlets into an instance so a harness does not reach into
# game/Mods itself. Sources are directories containing ModInfo.xml.
cmd_stage() {
  local name="$1"; shift || true
  [[ $# -ge 1 ]] || usage_err "usage: sb stage <name> <mod-dir> [mod-dir...]"
  local inst
  inst="$(instance_dir "$name")"
  stage_mods "$inst" "$@"
}

# Declare serverconfig properties for an instance. The suite or scenario that
# needs a world, a seed or spawn caps states them here rather than shipping its
# own XML rewriter. Declarations are recorded in instance.props and the config
# is rebuilt from the base template, so the result depends only on what is
# declared now, not on what a previous run left behind.
cmd_render_config() {
  local name="$1"; shift || true
  [[ $# -ge 1 ]] || usage_err "usage: sb render-config <name> KEY=VALUE [KEY=VALUE...]"
  local inst kv
  inst="$(instance_dir "$name")"
  for kv in "$@"; do
    validate_prop "$kv"
  done
  record_server_props "$inst" "$@"
  instance_server_ports "$inst"
  local port="$SERVER_PORT" telnet_port="$SERVER_TELNET_PORT"
  apply_server_config "$inst" "$name" "$port" "$telnet_port"
  echo "config -> $APPLIED_CONFIG"
}

cmd_run() {
  local mode="$1" name="$2"; shift 2
  [[ "${1:-}" == "--" ]] && shift
  validate_name "$name"
  case "$mode" in
    client)
      [[ -d "$INSTANCES_DIR/$name" ]] || cmd_create "$name" >/dev/null
      exec cmd_launch "$name" "$@"
      ;;
    server)
      [[ -d "$INSTANCES_DIR/$name" ]] || cmd_create_server "$name" >/dev/null
      exec cmd_launch_server "$name" "$@"
      ;;
    both)
      # Server first; client joins once the port is up. The stock client
      # ignores -connect=, so auto-join rides the sibling 7dtd-fastconnect
      # mod (reads 7DTD_CONNECT at menu, issues the console connect). Without
      # the sibling repo the client still launches and sits at the menu.
      local srv_name="srv-$name" cli_name="client-$name"
      if [[ ! -d "$INSTANCES_DIR/$cli_name" ]]; then
        cmd_create "$cli_name" >/dev/null
      fi
      stage_fastconnect "$INSTANCES_DIR/$cli_name"
      [[ -d "$INSTANCES_DIR/$srv_name" ]] || cmd_create_server "$srv_name" >/dev/null

      local srv_inst="$INSTANCES_DIR/$srv_name"
      instance_server_ports "$srv_inst"
      local srv_port="$SERVER_PORT"

      echo "starting server '$srv_name' (port $srv_port) in background..."
      start_server_detached "$srv_inst" "$srv_name" "$srv_port" "$(( srv_port + 1 ))"
      echo "waiting for server port $srv_port ..."
      if ! wait_for_port 127.0.0.1 "$srv_port" 90; then
        # Same as `sb up`: a server that never bound is stopped, not left
        # holding the port block behind a failed `run both`.
        echo "sb: bring-up failed, stopping the server it started" >&2
        terminate_instance "$srv_inst"
        die "server did not open port $srv_port in 90s; check $srv_inst/logs/server.log"
      fi
      echo "server up; launching client '$cli_name' with -connect=127.0.0.1:$srv_port"
      # Bash cannot export a name starting with a digit; the connect mod
      # reads the canonical name, so hand it over with env(1). cmd_launch
      # re-resolves it via printenv and passes it to the game the same way
      # launch_client.sh does.
      exec env 7DTD_CONNECT="127.0.0.1:$srv_port" \
        SB_CLIENT_CONNECT="127.0.0.1:$srv_port" \
        bash "$0" launch "$cli_name" -connect="127.0.0.1:$srv_port" "$@"
      ;;
    *) usage_err "unknown mode '$mode' (use client | server | both)" ;;
  esac
}

# --- dispatch --------------------------------------------------------------

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    init) cmd_init ;;
    doctor) cmd_doctor ;;
    fetch-base|fetch) cmd_fetch "${1:-}" ;;
    fetch-server-base) cmd_fetch_server_base "${1:-}" ;;
    run)
      [[ $# -ge 2 ]] || die "usage: sb run <client|server|both> <name> [-- args...]"
      local rmode="$1" rname="$2"; shift 2
      [[ "${1:-}" == "--" ]] && shift
      cmd_run "$rmode" "$rname" "$@"
      ;;
    create)
      [[ $# -ge 1 ]] || die "usage: sb create <name> [--res WxH] [--fullscreen 0|1]"
      local crname="$1"; shift
      cmd_create "$crname" "$@"
      ;;
    create-server)
      [[ $# -ge 1 ]] || die "usage: sb create-server <name> [--admin NAME...]"
      local csname="$1"; shift
      local cadmins=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --admin) shift; [[ $# -gt 0 ]] || usage_err "--admin needs a name"; cadmins+=("$1") ;;
          *) usage_err "unknown create-server option '$1' (--admin NAME)" ;;
        esac
        shift
      done
      cmd_create_server "$csname" "${cadmins[@]+"${cadmins[@]}"}"
      ;;
    up)
      [[ $# -ge 1 ]] || usage_err "usage: sb up <name> [--timeout N]"
      local uname="$1"; shift
      cmd_up "$uname" "$@"
      ;;
    stage)
      [[ $# -ge 2 ]] || usage_err "usage: sb stage <name> <mod-dir> [mod-dir...]"
      local gname="$1"; shift
      cmd_stage "$gname" "$@"
      ;;
    render-config)
      [[ $# -ge 2 ]] || usage_err "usage: sb render-config <name> KEY=VALUE [KEY=VALUE...]"
      local rname="$1"; shift
      cmd_render_config "$rname" "$@"
      ;;
    destroy)
      [[ $# -ge 1 ]] || die "usage: sb destroy <name> [name...]"
      local dn; for dn in "$@"; do cmd_destroy "$dn"; done
      ;;
    wipe)
      [[ $# -ge 1 ]] || die "usage: sb wipe <name> [name...]"
      local wn; for wn in "$@"; do cmd_wipe "$wn"; done
      ;;
    list|ls) cmd_list ;;
    status) [[ $# -ge 1 ]] || die "usage: sb status <name>"; cmd_status "$1" ;;
    launch|run-launch)
      [[ $# -ge 1 ]] || die "usage: sb launch <name> [-- args...]"
      local lname="$1"; shift
      [[ "${1:-}" == "--" ]] && shift
      cmd_launch "$lname" "$@"
      ;;
    launch-server)
      [[ $# -ge 1 ]] || die "usage: sb launch-server <name> [-- args...]"
      local lsname="$1"; shift
      [[ "${1:-}" == "--" ]] && shift
      cmd_launch_server "$lsname" "$@"
      ;;
    stop)
      [[ $# -ge 1 ]] || die "usage: sb stop <name> [name...]"
      local sn; for sn in "$@"; do cmd_stop "$sn"; done
      ;;
    logs) [[ $# -ge 1 ]] || die "usage: sb logs <name> [-f]"; cmd_logs "$1" "${2:-}" ;;
    env) [[ $# -ge 1 ]] || die "usage: sb env <name>"; cmd_env "$1" ;;
    version|--version|-V) echo "sb $SB_VERSION" ;;
    help|-h|--help|"") usage ;;
    *) die "unknown command '$cmd' (see 'sb help')" ;;
  esac
}

main "$@"
