#!/usr/bin/env bash
# 7dtd-safehouse — isolated client and/or dedicated-server instances
#
# Three launch modes:
#   sb run client   <name> [-- game args]   - client only (Proton, no Steam)
#   sb run server   <name>                  - dedicated server only (native, app 294420)
#   sb run both     <name> [-- game args]   - both; client auto-connects to the server
#
# Underlying commands (the public surface a harness drives):
#   create / create-server / up / stage / render-config / launch /
#   launch-server / stop / wipe / destroy / list / status / logs / env /
#   fetch-base / fetch-server-base / doctor / init / version
#
# Run `sb help` for the full list.
set -euo pipefail

SANDBOX_HOME="${SANDBOX_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
INSTANCES_DIR="${SANDBOX_INSTANCES:-$SANDBOX_HOME/instances}"
BASE_GAME="${SANDBOX_BASE_GAME:-$SANDBOX_HOME/base/game}"
SERVER_BASE_GAME="${SANDBOX_SERVER_BASE_GAME:-$SANDBOX_HOME/base/server-game}"
STEAMCMD_DIR="${SANDBOX_STEAMCMD:-$SANDBOX_HOME/tools/steamcmd}"
STEAM_APPID="${STEAM_APPID:-251570}"
SERVER_APPID="${SERVER_APPID:-294420}"
# Canonical version home for this repository (REPOSITORY_STANDARDS.md §8).
# The release workflow refuses a vX.Y.Z tag that disagrees with it.
SB_VERSION="0.3.0"
STEAM_ROOT="${STEAM_ROOT:-$HOME/.local/share/Steam}"
# Beside this script, not under SANDBOX_HOME: a caller may point
# SANDBOX_HOME at any instance root and sb must still find its own helper.
SB_CONFIG="${SB_CONFIG:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/sbconfig.py}"
# Interpreter for sbconfig.py, looked up on PATH: never a hardcoded
# /usr/bin/python3, because a venv, a pyenv shim or a distribution that ships
# python3.13 under that name is the ordinary case.
SB_PY="${SB_PY:-python3}"
# Oldest interpreter sbconfig.py supports, mirrored in its MIN_PYTHON and
# pinned equal by scripts/test_sb_cli.sh.
SB_PY_MIN="3.8"

# The instance port block, mirrored from sbconfig.py's PORT_BLOCK_*, which
# derives the block's first port. The block is a range, not a point: the game
# port, telnet at +1, and +2..+4 the dedicated's own ephemeral ports, so every
# check here bounds the last port of the block, never the first alone. A base
# port of 65535 satisfies `port <= 65535` and still puts telnet and two of the
# ephemeral ports outside the TCP/UDP space, where nothing binds them.
PORT_BLOCK_SIZE=5
PORT_BLOCK_LAST_OFFSET=$(( PORT_BLOCK_SIZE - 1 ))
PORT_MAX=65535

# --- what this run owns until it publishes it ------------------------------
#
# A staging tree a copy is being written into, a tree moved aside to be
# replaced, a temp declaration file, the directory a create is half-building.
# Each one is settled on every exit path, the ones a signal takes included: a
# `cp -a` of a 17 GB base interrupted at the keyboard otherwise leaves the
# staging tree, and the partial instance directory, inside instances/, and a
# lab that brings instances up and wipes them hundreds of times accumulates one
# of each per interrupted run. Nothing sweeps them, and a partial instance
# refuses every retry with "already exists".
#
# A SIGKILL leaves debris no handler can remove, so every name carries the pid
# that owns it: what is left is attributable to a run, not anonymous.
SB_PENDING=()
SB_RESTORE_SRC=()
SB_RESTORE_DST=()

sb_own_pending() { # sb_own_pending <path>: dropped when this run ends
  SB_PENDING+=("$1")
}

# A path that stops being garbage the moment this run ends, and what it has
# become: the tree publish_tree moved aside, which is the only copy of an
# instance's game until the replacement is renamed into place. Deleting it
# would be the failure the staged rename exists to prevent, so it goes back
# where it came from instead.
sb_own_restore() { # sb_own_restore <moved-aside> <where it belongs>
  SB_RESTORE_SRC+=("$1")
  SB_RESTORE_DST+=("$2")
}

# A path this run has published, or has decided never to own: an instance
# directory a finished create now lives in.
sb_release_pending() { # sb_release_pending <path>
  local p keep=() i
  for p in ${SB_PENDING[@]+"${SB_PENDING[@]}"}; do
    [[ "$p" == "$1" ]] || keep+=("$p")
  done
  SB_PENDING=(${keep[@]+"${keep[@]}"})
  for i in "${!SB_RESTORE_SRC[@]}"; do
    if [[ "${SB_RESTORE_DST[i]}" == "$1" ]]; then
      SB_RESTORE_SRC[i]=""
      SB_RESTORE_DST[i]=""
    fi
  done
}

# Settle both lists. A staged path that has already been renamed away is not
# there any more and `rm -rf` on a path that is not there is a no-op, so a
# published staging tree needs no release call to be safe here; only a path
# that has become a live tree does.
sb_settle_pending() {
  local i src dst p
  for i in "${!SB_RESTORE_SRC[@]}"; do
    src="${SB_RESTORE_SRC[i]}"
    dst="${SB_RESTORE_DST[i]}"
    [[ -n "$src" ]] || continue
    # A destination that is back means the replacement was published after all,
    # so the moved-aside tree is debris and is dropped below.
    if [[ -e "$src" && ! -e "$dst" ]]; then
      mv "$src" "$dst" 2>/dev/null \
        || warn "interrupted with $dst missing; the original tree is at $src"
    fi
  done
  for p in ${SB_PENDING[@]+"${SB_PENDING[@]}"}; do
    if [[ -e "$p" ]]; then rm -rf -- "$p"; fi
  done
  SB_PENDING=()
  SB_RESTORE_SRC=()
  SB_RESTORE_DST=()
}

# Settle, then let the signal take its normal course so the exit status is the
# one a caller waiting on this pid expects. The traps go with it: the lists are
# empty by now, and the signal must not be handled twice.
sb_on_signal() {
  sb_settle_pending
  trap - EXIT INT TERM HUP
  kill -s "$1" "$$"
}

# The window `sb create` records when the caller declares none, and the one
# `sb launch` falls back to for an instance created before the window was
# declared. Declared here rather than at either use site: two copies of one
# default are two answers to the same question, and the AGENTS.md contract and
# `sb help` both name this number.
SB_DEFAULT_RES="1280x720"
SB_DEFAULT_FULLSCREEN="0"

# Seconds a bring-up waits for the game port before it stops the server it
# started and fails. `sb up --timeout N` overrides it; `sb run both` has no
# flag for it, so both paths wait the same number of seconds for the same port.
SB_UP_TIMEOUT=180

die() { echo "sb: $*" >&2; exit 1; }
# Exit 2 for every usage error: a refused flag, a bad declaration, a missing
# instance, an invalid name, an unknown command, and a missing argument. Exit 1
# is reserved for a command that was understood and failed (a missing base, a
# copy that ran out of space, a server that never bound), so a script can tell
# "you called me wrong" from "the run failed" without parsing messages.
usage_err() { echo "sb: $*" >&2; exit 2; }
warn() { echo "sb: WARN: $*" >&2; }
# Every verb the dispatcher knows, so an unknown one can be answered with a
# near match rather than a bare refusal.
COMMANDS=(
  init doctor fetch-base fetch-server-base
  run create create-server up stage render-config
  launch launch-server wipe destroy stop
  list status logs env version help
)

# The command an unknown one most likely meant. Two passes: the shortest known
# command that starts with, or contains, what was typed; failing that, the
# shortest one sharing its first two characters, which is what catches the
# transposed or truncated verb ("stpo" -> stop, "logsx" -> logs). Nothing
# matches a word that is not near a verb, so the command list is offered
# instead of a guess.
suggest_command() {
  local input="$1" c best="" stem="${1:0:2}"
  (( ${#input} >= 2 )) || return 0
  for c in "${COMMANDS[@]}"; do
    if [[ "$c" == "$input"* || "$c" == *"$input"* ]]; then
      if [[ -z "$best" || ${#c} -lt ${#best} ]]; then best="$c"; fi
    fi
  done
  if [[ -z "$best" ]]; then
    for c in "${COMMANDS[@]}"; do
      if [[ "$c" == "$stem"* ]]; then
        if [[ -z "$best" || ${#c} -lt ${#best} ]]; then best="$c"; fi
      fi
    done
  fi
  if [[ -n "$best" ]]; then
    printf "  did you mean 'sb %s'?\n" "$best" >&2
  else
    printf "  run 'sb help' for the command list.\n" >&2
  fi
}

usage() {
  cat <<'EOF'
Usage: sb <command> [args]

Standardized, isolated 7DTD client AND dedicated-server instances
(no Steam, no EOS, no Twitch).

Quick launch (three modes):
  run client <name> [-- args...]  client-only: Proton, no Steam (blocking)
  run server <name>               dedicated server only (blocking)
  run both   <name> [-- args...]  server + client; client auto-joins server

Underlying commands (full control):
  fetch-base [--validate | --seed-from-steam]
                       steamcmd-pull the pristine client (Windows depot forced)
  fetch-server-base [--validate]
                       steamcmd-pull the dedicated server (anonymous OK)
  create <name> [--res WxH] [--fullscreen 0|1]
                       fresh isolated client instance (game copy + Proton
                       prefix + its declared window; default windowed 1280x720)
  create-server <name> [--admin NAME...]
                       fresh isolated server instance (game copy + name-derived
                       port block + declared Local admins; NAME is [A-Za-z0-9._-])
  up <name> [--timeout N]       start the server detached, block until its
                       game port listens, then print the contract (stop: sb stop)
  stage <name> <mod-dir>...     copy built modlets into the instance's Mods
  render-config <name> KEY=VALUE...
                       declare serverconfig properties; the config is rebuilt
                       from the base template plus every declaration
                       (KEY is [A-Za-z_][A-Za-z0-9_]*, VALUE is one line)
  launch <name> [-- args...]    run client under Proton, no Steam
  launch-server <name>          run dedicated server, blocking
  wipe <name> [name...] reset game/Mods/saves to pristine
  destroy <name> [name...]      remove instance entirely (already gone: exit 0,
                       so a re-run teardown converges rather than failing)
  stop <name> [name...]         TERM/KILL only this instance's processes
  list                  list instances with running state
  status <name>         show one instance's state and paths
  logs <name> [-f]      tail the instance's log
  env <name>            eval-able contract for sibling harnesses
  doctor                report readiness
  version               print the sb version
  help                  this text

Standard env: SANDBOX_HOME, SANDBOX_INSTANCES, SANDBOX_BASE_GAME,
SANDBOX_SERVER_BASE_GAME, SANDBOX_STEAMCMD, STEAM_APPID, SERVER_APPID,
STEAM_ROOT, PROTON, GFX_API, SB_RES (default 1280x720),
SB_FULLSCREEN (default 0=windowed), SB_CONFIG, SB_PY (default python3, needs
3.8+), STEAMCMD_USER, 7DTD_PLAYER_NAME, STEAM_SEED_SOURCE, FASTCONNECT_DIST.

Host: Linux, bash, and that python3 on PATH (sb doctor reports both).

Credentials: STEAMCMD_USER is the account name; the password is never read
from the environment (it would have to reach steamcmd as an argument, which
the process table exposes). 'sb fetch-base' prompts for it on a terminal.

Every command takes --help: 'sb help <command>' and 'sb <command> --help'
print the same page, so a caller never has to guess a flag.

Exit codes: 0 success, 1 the run failed, 2 the command line was wrong.

Output: a line prefixed 'sb:' is a diagnostic and goes to stderr. stdout
carries data only, so these can be piped or evaluated as they are:
  sb up <name>       the contract (progress and diagnostics go to stderr)
  sb env <name>      the contract
  sb list | status   the rows
  sb logs <name>     the log lines
EOF
}

# One page per verb, reached by 'sb help <command>' or 'sb <command> --help'.
# A page states the usage line, what the verb does, its own flags, and one
# worked example, because the general page lists the verbs but not their flags.
usage_for() {
  case "$1" in
    run) cat <<'EOF'
Usage: sb run <client|server|both> <name> [-- args...]

Start an instance, creating it on first use. Blocks until the game exits.

  client  client only, under Proton, no Steam
  server  dedicated server only, native
  both    server + client; the client auto-joins the server

Everything after '--' is passed to the game unchanged. 'both' names its
instances srv-<name> and client-<name> and stops them with 'sb stop' on both.

Examples:
  sb run both lab
  sb run client client-lab -- -connect=127.0.0.1:27535
EOF
      ;;
    create) cat <<'EOF'
Usage: sb create <name> [--res WxH] [--fullscreen 0|1]

Create a fresh client instance: a reflinked game copy, its own Proton prefix,
and its declared window. Refuses a name that already exists.

  --res WxH        windowed resolution, recorded in the instance (default 1280x720)
  --fullscreen 0|1 0 windowed (default), 1 fullscreen; a sandbox client is a
                   test fixture, so it stays windowed

The window is declared once here and read from the instance at every launch,
so the same instance opens the same window on any machine.

Example: sb create client-lab --res 1920x1080
EOF
      ;;
    create-server) cat <<'EOF'
Usage: sb create-server <name> [--admin NAME]...

Create a fresh server instance: a reflinked game copy, a name-derived 5-port
block, and the declared Local admins. Refuses a name that already exists.

  --admin NAME     admit this Local player name at permission_level=0.
                   NAME matches [A-Za-z0-9._-]; repeatable.

'sb up' creates a server instance on its own, so this is only needed to set up
an instance ahead of the bring-up. The contract is read back with 'sb env'.

Example: sb create-server srv-lab --admin alice
EOF
      ;;
    up) cat <<'EOF'
Usage: sb up <name> [--timeout N]

Start a server instance detached, block until its game port accepts
connections, then print the instance contract on stdout. Creates the instance
on first use. Exits non-zero, and stops the server it started, if the port
never opens.

  --timeout N      seconds to wait for the port (default 180)

The contract is the only thing on stdout, so the call can be evaluated:

  eval "$(sb up srv-lab --timeout 240)"

Progress and diagnostics go to stderr.
EOF
      ;;
    launch|launch-server) cat <<'EOF'
Usage: sb launch <name> [-- args...] | sb launch-server <name> [-- args...]

Run an existing instance in the foreground and block. 'launch' is the client
under Proton (no Steam), 'launch-server' the dedicated server. Everything
after '--' is passed to the game unchanged; a '-screen-*' argument there
overrides the window the instance declared.

The instance is not created here: 'sb create' / 'sb create-server' first, or
'up' for a server.

Examples:
  sb launch client-lab
  sb launch-server srv-lab -- -logfile /tmp/srv.log
EOF
      ;;
    stage) cat <<'EOF'
Usage: sb stage <name> <mod-dir> [mod-dir...]

Copy built modlets into the instance's game/Mods. A mod-dir is a directory
holding ModInfo.xml. Re-staging a modlet replaces the copy the instance runs;
a replacement that fails leaves the previous one in place.
EOF
      ;;
    render-config) cat <<'EOF'
Usage: sb render-config <name> KEY=VALUE [KEY=VALUE...]

Declare serverconfig properties for an instance. The config is rebuilt from
the pristine base template plus every declaration, so nothing carries over
from a previous run and undeclaring a key returns it to the stock value.

  KEY        [A-Za-z_][A-Za-z0-9_]*, the property name the game reads
  VALUE      one line, valid UTF-8

ServerPort, TelnetPort and UserDataFolder are instance-owned and refused: the
instance allocated the ports, and a config that disagrees sends every harness
at a port nothing binds.

Example: sb render-config srv-lab GameWorld=Navezgane MaxSpawnedZombies=0
EOF
      ;;
    stop) cat <<'EOF'
Usage: sb stop <name> [name...]

Stop only these instances' processes: TERM, then KILL what is still standing.
Matching is by the instance's own marker (SB_INSTANCE for a server,
STEAM_COMPAT_DATA_PATH for a client), never by process-name pattern, so one
instance's teardown never touches another's. Exits 0 for an instance that is
not running.
EOF
      ;;
    wipe) cat <<'EOF'
Usage: sb wipe <name> [name...]

Reset instances to pristine base state: game, Mods, and saves (plus userdata
and the declared config on a server). The instance keeps its identity, port
block and admins; its declared serverconfig properties go with the state they
configured. Refuses an instance that is running.
EOF
      ;;
    destroy) cat <<'EOF'
Usage: sb destroy <name> [name...]

Remove instances entirely, game tree and Proton prefix included. A running
instance is stopped first. This cannot be undone; 'sb wipe' resets state and
keeps the instance.
EOF
      ;;
    list) cat <<'EOF'
Usage: sb list

One row per instance: name, kind (client/server), running state, and path.
EOF
      ;;
    status) cat <<'EOF'
Usage: sb status <name>

One instance's state and paths, followed by its instance.env contract.
EOF
      ;;
    logs) cat <<'EOF'
Usage: sb logs <name> [--follow]

Print the last 40 lines of the instance's log, or follow it.

  -f, --follow    keep tailing the log as it grows

The log is chosen by instance kind: logs/server.log for a server,
logs/output_log_client.txt for a client.
EOF
      ;;
    env) cat <<'EOF'
Usage: sb env <name>

Print the instance contract as 'export KEY=VALUE' lines, quoted so a value
carrying a quote or a command substitution stays data. The documented consumer
is an eval:

  eval "$(sb env srv-lab)"

Both instance kinds print it, a client including the resolved SB_SCREEN_ARGS.
EOF
      ;;
    fetch-base) cat <<'EOF'
Usage: sb fetch-base [--validate | --seed-from-steam]

steamcmd-pull the pristine client base (the Windows depot is forced, the
sibling ecosystem targets the Windows build under Proton). Needs a Steam
account: the client is a paid app, so it is fetched as STEAMCMD_USER, whose
password steamcmd prompts for on a terminal.

  --validate            let steamcmd hash-verify every file (off by default:
                        the sandbox's rule is that Steam never owns these files)
  --seed-from-steam     reflink the base from an existing Steam install
                        (STEAM_SEED_SOURCE) instead of downloading

Refuses a base inside a Steam library, and refuses an exported STEAMCMD_PASS.
EOF
      ;;
    fetch-server-base) cat <<'EOF'
Usage: sb fetch-server-base [--validate]

steamcmd-pull the pristine dedicated-server base (app 294420, anonymous).

  --validate            let steamcmd hash-verify every file (off by default)

Refuses a base inside a Steam library.
EOF
      ;;
    doctor|init) cat <<'EOF'
Usage: sb doctor | sb init

Report host readiness: sandbox paths, Proton, steamcmd, the Python sbconfig.py
needs, both bases and what mods they ship, reflink support, and the
Steam-ownership guard. 'init' prints the first part only and creates the
directory layout.
EOF
      ;;
    version) cat <<'EOF'
Usage: sb version

Print the shipped version. The canonical declaration is SB_VERSION in scripts/sb.
EOF
      ;;
    help) usage ;;
    -h|--help|"") usage ;;
    *)
      # A name that is not a verb gets the same answer as typing it: the
      # refusal names what it is near, and a help request does not launder an
      # unknown command into a successful exit.
      echo "sb: unknown command '$1'" >&2
      suggest_command "$1"
      exit 2
      ;;
  esac
}

# --- detection -------------------------------------------------------------

# Every serverconfig render, admin seed and port derivation shells out to
# sbconfig.py, so an absent or too-old interpreter is not a bare
# `command not found` halfway through `sb create-server`. Checked where the
# interpreter is used, so `sb version` and `sb help` keep working without one.
require_python() {
  command -v "$SB_PY" >/dev/null 2>&1 \
    || die "$SB_PY not on PATH; sbconfig.py needs Python $SB_PY_MIN or newer"
  # The probe's own stderr is kept and reported. Discarding it (2>/dev/null)
  # made every failure of this check read as "is older than 3.7", including the
  # ones that are not that at all: an interpreter that cannot import sys, a
  # venv whose python is a dangling symlink, a wrapper that exits nonzero for
  # its own reasons. The operator was told to install a newer Python for what
  # was really a broken interpreter.
  local why
  why="$("$SB_PY" -c 'import sys; sys.exit(sys.version_info < tuple(int(p) for p in sys.argv[1].split(".")))' \
        "$SB_PY_MIN" 2>&1)" \
    || die "$SB_PY cannot run the version probe; sbconfig.py needs Python $SB_PY_MIN or newer: ${why:-no output}"
}

detect_proton() {
  if [[ -n "${PROTON:-}" ]]; then
    [[ -x "$PROTON" ]] || die "PROTON set but not executable: $PROTON"
    echo "$PROTON"
    return 0
  fi
  local p
  for p in \
    "$STEAM_ROOT/steamapps/common/Proton - Experimental/proton" \
    "$STEAM_ROOT/steamapps/common/Proton 11.0/proton" \
    "$STEAM_ROOT/steamapps/common/Proton 10.0/proton" \
    "$HOME/.steam/steam/steamapps/common/Proton - Experimental/proton"
  do
    if [[ -x "$p" ]]; then echo "$p"; return 0; fi
  done
  die "no Proton found; set PROTON=/path/to/proton"
}

# --- instance plumbing -----------------------------------------------------

validate_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || usage_err "invalid instance name '$1' (use [A-Za-z0-9._-], not starting with '-')"
}

# An instance root whose path cannot be written into instance.env unquoted.
#
# instance.env is a KEY=VALUE contract whose values are the instance's own
# paths, and it is documented for two consumers: `sb env` re-quotes it for
# eval, but a sibling harness is told to `source` the file directly. A root
# holding a space, a quote, a glob or a shell metacharacter therefore writes a
# contract whose sourcing half-evaluates: `GAME=/srv/lab/game` sets GAME to
# /srv/lab and runs `lab/game` as a command, and the harness starts with a
# path that is not a path. `sb env` hides it, `sb status` does not, so the
# breakage surfaces as a missing game directory rather than as a bad root.
#
# Refused at create, where the refusal can name the character and the
# variable to move. The name, the ports, the window and the admins are
# already charset-checked at the same boundary, so the instance path is the
# only value left in that file that is not.
assert_contract_safe_root() {
  local path="$1" bad
  [[ "$path" == *[^A-Za-z0-9._/-]* ]] || return 0
  bad="$(printf '%s' "$path" | tr -d 'A-Za-z0-9._/-' | tr -s '[:space:]' ' ')"
  die "instance root $path holds [$bad], which a KEY=VALUE instance.env line
    cannot carry unquoted; point SANDBOX_INSTANCES at a path of [A-Za-z0-9._/-]"
}

# One declared value from an instance's instance.env, or empty. Every reader
# that wants a single value goes through here, so a key is looked up the same
# way everywhere: last declaration wins, a missing key reads as empty rather
# than as the comment lines that surround it. Last wins because that is what
# `sb env` hands the caller: it exports every declaration, so the shell's own
# last-one-wins settles a hand-edited duplicate before any reader of this file
# ever sees it. `cmd_env` is the one reader that walks the file itself, because
# it emits every declaration rather than one.
# One sed, no second process to trim its output: the bring-up paths look up a
# dozen keys each.
# The trailing `|| true` is this function's return value, not noise: the file
# is absent for an instance nothing has written a contract into yet, sed exits
# 2, and under `set -o pipefail` a caller outside a command substitution (a
# subshell would swallow it) takes the whole script down with it. "No such
# key" is empty, the same answer as "no such line".
env_value() {
  unquote_value "$(sed -n "s/^$2=//p" "$1/instance.env" 2>/dev/null | tail -1 || true)"
}

# The inverse of shquote: the value a sourcing shell would assign to a line
# env_line wrote. An unquoted hand-edit passes through as written, and an
# unbalanced quote is left alone rather than silently truncated.
unquote_value() {
  local s="$1"
  if [[ "$s" == \'*\' ]]; then
    s="${s:1:${#s}-2}"
    s="${s//\'\\\'\'/\'}"
  fi
  printf '%s' "$s"
}

# An instance-owned key the bring-up cannot proceed without.
require_env_value() {
  local inst="$1" key="$2" value
  value="$(env_value "$inst" "$key")"
  [[ -n "$value" ]] || die "no $key in $inst/instance.env (recreate the instance)"
  echo "$value"
}

# A serverconfig property name is the stock config's own charset, and it is a
# regex in the upsert that rewrites an existing property and a line prefix in
# instance.props, so nothing outside [A-Za-z_][A-Za-z0-9_]* reaches either.
# One predicate, because the two spellings it replaced disagreed on the
# leading underscore and validate_prop is the only caller.
prop_key_ok() {
  [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

# One value as a single shell word, for the consumer that evaluates `sb env`.
# A quote in a path or a declared value stays inside the string instead of
# closing it and running whatever followed. The result lands in REPLY rather
# than on stdout: every call site is a printf argument, and reading it back
# through $(...) would cost a fork per value.
shquote() {
  local s="${1//\'/\'\\\'\'}"
  REPLY="'${s}'"
}

# One `KEY=value` line for instance.env, value quoted through shquote. The
# file is documented as source-able and `sb env` reads it back, so a value
# written bare is a value a sourcing shell re-splits: `PROTON=/…/Proton -
# Experimental/proton` assigns the prefix and then runs `-` as a command, and
# a value carrying a newline writes a second line the sourcing shell executes.
# Readers take the quotes back off through env_value.
env_line() { # env_line <KEY> <VALUE>
  shquote "$2"
  printf '%s=%s\n' "$1" "$REPLY"
}

# Steam only ever validates files it owns (inside a steamapps library). The
# sandbox's whole isolation story is that Steam neither owns nor touches base/
# or instances/, so a directory under any steamapps tree is refused here.
assert_not_steam_owned() {
  local path="$1" what="$2"
  local resolved cur
  if [[ -d "$path" ]]; then
    resolved="$(cd "$path" 2>/dev/null && pwd)" || resolved="$path"
  else
    resolved="$(cd "$(dirname "$path")" 2>/dev/null && pwd)/${path##*/}" || resolved="$path"
  fi
  case "$resolved" in
    */steamapps|*/steamapps/*)
      die "$what must not live inside a Steam library ($resolved); Steam would own and verify these files"
      ;;
  esac
  # SANDBOX_HOME may itself be a Steam library root (…/steamlib holding
  # steamapps/). A library is identified by steamapps/common, not by steamapps
  # alone: steamcmd writes its own steamapps/ (appmanifest, downloading, temp)
  # straight into whatever +force_install_dir it was given, so `base/game`
  # carries one after every fetch. Testing for the bare directory refused our
  # own pristine base.
  cur="$resolved"
  while [[ -n "$cur" && "$cur" != "/" ]]; do
    if [[ -d "$cur/steamapps/common" ]]; then
      die "$what must not live inside a Steam library ($resolved); Steam would own and verify these files"
    fi
    cur="$(dirname "$cur")"
  done
}

instance_dir() {
  validate_name "$1"
  local inst="$INSTANCES_DIR/$1"
  [[ -d "$inst" ]] || usage_err "instance '$1' not found (create it with 'sb create $1' or 'sb create-server $1')"
  echo "$inst"
}

# Everything a create writes into an instance directory. A directory holding
# no instance.env and nothing outside this set is not an instance: it is a
# create that was killed between the mkdir and the contract, which the
# create's rollback cannot reach because rollback only runs when the create
# failed on its own terms.
CREATE_ARTIFACTS='game compatdata userdata logs instance.props'

# The instance exists, or create it. This is the auto-create path a harness
# lands on when it re-runs `sb up` or `sb run` against an instance it never
# finished building.
#
# `[[ -d ]]` alone read a half-finished create as an instance: the bring-up
# then died with "missing instance.env (recreate the instance)" for a
# directory no create ever completed, and every retry died the same way until
# somebody removed the tree by hand. A directory with no contract is removed
# and built again, and only when it holds nothing but what a create writes, so
# a directory somebody put under instances/ by hand is refused by name rather
# than deleted. An existing instance is left exactly as it is.
ensure_instance() { # ensure_instance <name> <create-command> <name>
  local name="$1"; shift
  local inst="$INSTANCES_DIR/$name" entry
  if [[ -d "$inst" && ! -f "$inst/instance.env" ]]; then
    for entry in "$inst"/* "$inst"/.[!.]*; do
      [[ -e "$entry" ]] || continue
      case " $CREATE_ARTIFACTS " in
        *" ${entry##*/} "*) ;;
        *) die "$inst holds '${entry##*/}', which no create writes and has no instance.env; refusing to remove it (move it aside, then re-run)" ;;
      esac
    done
    echo "sb: $inst is an instance a previous create did not finish; removing it" >&2
    rm -rf "$inst" || die "could not remove the incomplete instance at $inst"
  fi
  [[ -d "$inst" ]] || "$@"
}

# Replace $dst with a fresh copy of $src. The copy is built in a staging
# sibling and published with a rename, because both of the obvious shortcuts
# lose data on a failed copy:
#
#   rm -rf "$dst"; cp ...   an unreadable file, a full disk or an interrupt
#                           destroys the tree and then fails to rebuild it, so
#                           `sb wipe` left the instance with no game at all and
#                           its staged Mods gone with the old tree.
#   cp ... onto a dirty $dst  the failed reflink attempt leaves a partially
#                           populated $dst, and the --reflink=auto retry then
#                           copies the source *into* it, so a failed
#                           reflink produced a structurally wrong tree
#                           (game/server-game/7DaysToDieServer.x86_64) that
#                           reported success on the retry.
copy_tree() {
  local src="$1" dst="$2" what="$3"
  local staging="$dst.incoming.$$" err
  sb_own_pending "$staging"
  rm -rf "$staging"
  if err="$(cp -a --reflink=always "$src" "$staging" 2>&1)"; then
    publish_tree "$staging" "$dst"
    return 0
  fi
  rm -rf "$staging"
  if err="$(cp -a --reflink=auto "$src" "$staging" 2>&1)"; then
    warn "reflink unavailable, plain-copied $what (slower)"
    publish_tree "$staging" "$dst"
    return 0
  fi
  rm -rf "$staging"
  # cp's own message is the actionable part (which file, which reason); the
  # bare "copy failed" this replaced left the operator guessing at a 17 GB
  # tree copy.
  die "could not copy $what from $src to $dst: ${err:-cp reported no reason}"
}

# Swap a fully staged tree in for $dst. The tree being replaced is moved aside
# only once the replacement exists, and is moved back if the install fails, so
# no failure on this path can leave a caller with less than it started with.
publish_tree() {
  local staging="$1" dst="$2"
  local old="$dst.replaced.$$"
  if [[ -e "$dst" ]]; then
    mv "$dst" "$old" || die "could not move $dst aside to replace it"
    # From here to the rename below, $old is the only copy of the tree, so an
    # interrupt puts it back rather than dropping it.
    sb_own_restore "$old" "$dst"
  fi
  if mv "$staging" "$dst"; then
    # Published: the tree that was moved aside is now debris, and the handler
    # sees a destination that is already back, so it drops it.
    sb_own_pending "$old"
    rm -rf "$old"
    return 0
  fi
  if [[ -e "$old" ]]; then
    mv "$old" "$dst" || warn "could not restore $dst from $old; the original tree is at $old"
  fi
  die "could not install $dst from $staging"
}

# The platform surface an instance runs with. A client is Local only (no Steam
# auth, no EOS); a server keeps the stock surface with Steam listed first, but
# still admits Local joins, which is what the seeded admins authenticate with.
# Only the first line differs, so it is the only argument.
write_platform() { # write_platform <cfg> <platform>
  printf 'platform=%s\ncrossplatform=None\nserverplatforms=Steam,LAN,Local,\n' "$2" > "$1"
}

ensure_local_platform() {
  local cfg="$1/platform.cfg"
  if [[ -f "$cfg" ]] && grep -q '^platform=Local' "$cfg"; then
    return 0
  fi
  write_platform "$cfg" Local
  echo "instance platform.cfg set to Local (no Steam auth, no EOS)"
}

# instance.env is the contract a caller sources or evals, and on a server it
# carries SERVER_ADMINS: the Local player names that server admits. The two
# files those names reach serveradmin.xml and serverconfig.xml are both
# written 0600; this one was left to the umask, so a 022 shell left every
# player name on the host readable to every account. User-only, like the rest
# of what it names.
restrict_instance_env() {
  local env_file="$1/instance.env"
  [[ -f "$env_file" ]] || return 0
  chmod 0600 "$env_file" 2>/dev/null \
    || warn "could not restrict $env_file to 0600 (check the filesystem's mode support)"
}

# The instance directory holds what a run knows about the people playing on
# it: the seeded admin names, the server log naming who connected, the saves
# and the client's Proton prefix. The files sb writes are published 0600, but
# the ones the game writes carry the process umask (0644 under the usual 022)
# and mkdir left every directory here at 0755, so on a host with more than one
# account the same names were readable through the log and the saves. The
# directory is what carries the restriction, because the game creates the
# files; everything sb wrote was already restricted by name.
restrict_instance_dir() {
  local inst="$1"
  [[ -d "$inst" ]] || return 0
  chmod 0700 "$inst" 2>/dev/null \
    || warn "could not restrict $inst to 0700 (check the filesystem's mode support)"
}

# Always-admin for Local sandbox clients. Stock auth maps PltfmId
# `Local_<playername>` to platform="Local" userid=<playername>. Without a
# seed, Local joins land as permission 1000 and cannot run dm/givetools. The
# names are read back from this instance's own SERVER_ADMINS declaration, never
# discovered from whatever other instances exist on the machine. Idempotent:
# creates the file if missing, otherwise upserts a level-0 Local entry per
# declared name.
seed_sandbox_admins() {
  local inst="$1" declared name
  declared="$(env_value "$inst" SERVER_ADMINS)"
  # An instance created before SERVER_ADMINS existed still gets its pair name.
  [[ -n "$declared" ]] || declared="$(default_server_admins "${inst##*/}")"
  require_python
  # The names go in on stdin, never as arguments: an argument is readable
  # through /proc/<pid>/cmdline by every account on the host for as long as
  # the process lives, which publishes the player names this server admits.
  # This runs on every server bring-up, so an instance.env written before the
  # guard existed is restricted too, not only the ones created after it.
  restrict_instance_dir "$inst"
  restrict_instance_env "$inst"
  {
    local IFS=,
    # set -f: the split words are player names, not patterns. A hand-edited
    # SERVER_ADMINS carrying a `*` would otherwise expand to the files in the
    # current directory and seed whatever it found there at level 0.
    set -f
    for name in $declared; do
      if [[ -n "$name" ]]; then printf '%s\n' "$name"; fi
    done
  } | "$SB_PY" "$SB_CONFIG" seed-admins "$inst/userdata"
}


# Host-visible logs: the game writes C:/users/steamuser/AppData/Roaming/7DaysToDie/logs
# inside the prefix; replace that dir with a symlink to $inst/logs so harnesses
# read host paths. Re-run at every launch (idempotent).
link_prefix_logs() {
  local inst="$1"
  local pfxlog="$inst/compatdata/pfx/drive_c/users/steamuser/AppData/Roaming/7DaysToDie/logs"
  if [[ -d "$inst/compatdata/pfx" ]]; then
    mkdir -p "$(dirname "$pfxlog")"
    rm -rf "$pfxlog"
    if ! ln -s "$inst/logs" "$pfxlog"; then
      # Not fatal, and not silent either. Without the link the game writes its
      # log inside the prefix, so the host path instance.env declares as
      # LOGFILE is never created and every `sb logs` and every harness reading
      # it finds nothing, with the client otherwise running fine.
      warn "could not link $pfxlog to $inst/logs; the client log will stay inside the prefix and \$LOGFILE will not exist"
    fi
  fi
}

# Every pid whose environment carries one of the given "MARKER=VALUE" strings,
# as "<marker>\t<pid>" lines. One grep reads every /proc/<pid>/environ at once:
# the previous per-process `tr | grep` pair cost two forks per process, so a
# host with 500 processes paid 1000 of them per `sb list` row.
# `grep -z` is what makes this possible: /proc/<pid>/environ is NUL-separated,
# so -z is the only mode in which a whole "K=V" record is a line to match. -o
# then prints the record with its NUL, and no newline, so one tr restores the
# line separation the loop reads.
# Pids whose environ is not readable are skipped by grep, exactly as before.
pids_for_markers() {
  (($#)) || return 0
  # One -e per marker, not a -f pattern file: a process substitution nested
  # inside the outer one (the read below) is opened too late for grep to see.
  local -a pats=()
  local m line path pid marker
  for m in "$@"; do
    pats+=(-e "$m")
  done
  while IFS= read -r line || [[ -n "$line" ]]; do
    path="${line%%:*}"
    marker="${line#*:}"
    pid="${path#/proc/}"
    pid="${pid%/environ}"
    [[ "$pid" == "$$" || "$pid" == "$PPID" ]] && continue
    printf '%s\t%s\n' "$marker" "$pid"
  done < <(grep -azH -o -x -F "${pats[@]}" /proc/[0-9]*/environ 2>/dev/null \
    | tr '\0' '\n' || true)
}

# Instance kind: 'server' for server instances, 'client' otherwise.
instance_kind() {
  local inst="$1"
  if [[ "$(env_value "$inst" SERVER_KIND)" == server ]]; then
    echo server
  else
    echo client
  fi
}

# The environment marker that binds a process to this instance. Clients carry
# their unique STEAM_COMPAT_DATA_PATH; server instances carry SB_INSTANCE (set
# at launch). One place decides it, so a scan can ask for every instance's
# marker in a single pass.
instance_marker() {
  if [[ "$(instance_kind "$1")" == server ]]; then
    printf 'SB_INSTANCE=%s\n' "$1"
  else
    printf 'STEAM_COMPAT_DATA_PATH=%s/compatdata\n' "$1"
  fi
}

# Running pids for an instance of either kind, one per line and without the
# marker column: what stop, destroy, wipe and the running-instance guard
# consume (kill takes a pid, not a "<marker>\t<pid>" line).
instance_procs() {
  local marker pid
  while IFS=$'\t' read -r marker pid || [[ -n "$marker" ]]; do
    if [[ -n "$pid" ]]; then
      printf '%s\n' "$pid"
    fi
  done < <(pids_for_markers "$(instance_marker "$1")")
}

# --- client commands -------------------------------------------------------

require_base() {
  [[ -d "$BASE_GAME" ]] || die "base game missing at $BASE_GAME (run 'sb fetch-base' first)"
  [[ -f "$BASE_GAME/7DaysToDie.exe" ]] || die "base game incomplete: no 7DaysToDie.exe in $BASE_GAME"
}

# Per-instance online-service opt-outs, written into the instance's own prefix
# registry so no instance ever phones home by default.
seed_offline_prefs() {
  local inst="$1"
  [[ -d "$inst/compatdata/pfx" ]] || return 0
  local proton
  proton="$(detect_proton)"
  local prefs="HKCU\\Software\\The Fun Pimps\\7 Days To Die"
  if ( cd "$inst/game" \
       && env STEAM_COMPAT_DATA_PATH="$inst/compatdata" \
              STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT" \
              "$proton" run reg.exe add "$prefs" /v "DiscordDisabled_h2080590481" /t REG_DWORD /d 1 /f >/dev/null 2>&1 ); then
    echo "offline prefs seeded: Discord disabled"
  else
    warn "could not seed Discord-off pref (online services stay at game defaults)"
  fi
}

# Fetching needs steamcmd; running does not. The runtime container ships none
# on purpose, so say which image does the job instead of failing inside a `cd`
# to a directory that was never there.
require_steamcmd() {
  [[ -x "$STEAMCMD_DIR/steamcmd.sh" ]] && return 0
  die "no steamcmd at $STEAMCMD_DIR/steamcmd.sh (set SANDBOX_STEAMCMD).
    Fetching a base is a provisioning job: run it on the host, or in the
    'fetch' image (docker build --target fetch -f Dockerfile.safehouse .).
    The runtime image ships no steamcmd by design."
}

# The app id goes straight to steamcmd's `app_update`, where a typo fetches
# whatever that number happens to be (or fails deep in the download), and it
# is also the SteamAppId the client launch exports. A non-numeric value is a
# misconfiguration, not something to discover mid-fetch.
require_appid() { # require_appid <appid> <name>
  if [[ ! "$1" =~ ^[1-9][0-9]*$ ]]; then
    die "$2 must be a Steam app id (got '$1')"
  fi
}

cmd_fetch() {
  # Steam verification off by default: -validate makes steamcmd hash-check
  # every file against the depot. The whole point of the sandbox is Steam
  # never owns these files; pass --validate to opt in.
  local validate=()
  case "${1:-}" in
    --validate) validate=(-validate); echo "sb: steam data-file validation enabled (--validate)" >&2 ;;
    --seed-from-steam) cmd_seed_from_steam; return 0 ;;
    "") ;;
    *) usage_err "unknown fetch-base option '$1' (--validate | --seed-from-steam)" ;;
  esac
  # steamcmd only takes a password as a `+login user pass` argument, and argv
  # is world-readable: every local user on the box could read the Steam
  # password off the process table for the length of the fetch. Refused before
  # anything else, rather than silently dropped, so an exported STEAMCMD_PASS
  # fails loudly instead of leaking (see SECURITY.md).
  if [[ -n "${STEAMCMD_PASS:-}" ]]; then
    usage_err "STEAMCMD_PASS is refused: steamcmd takes a password only as a command-line
    argument, which the process table exposes. Unset it and let steamcmd prompt
    ('sb fetch-base' in a terminal; 'make fetch-base-docker' allocates a TTY)."
  fi
  require_steamcmd
  require_appid "$STEAM_APPID" STEAM_APPID
  assert_not_steam_owned "$BASE_GAME" "base game"
  mkdir -p "$BASE_GAME"
  local login=(+login anonymous)
  if [[ -n "${STEAMCMD_USER:-}" ]]; then
    login=(+login "$STEAMCMD_USER")
    [[ -t 0 ]] || echo "sb: stdin is not a terminal; steamcmd cannot prompt for the password here." >&2
  else
    echo "sb: anonymous login; the 7DTD client (251570) needs a subscription, so this will" >&2
    echo "    fail with 'No subscription' unless the app is free. For a real account set" >&2
    echo "    STEAMCMD_USER, or run 'sb fetch-base' in a terminal and" >&2
    echo "    type the password when prompted." >&2
  fi
  if ! ( cd "$STEAMCMD_DIR" && ./steamcmd.sh +@sSteamCmdForcePlatformType windows \
      +force_install_dir "$BASE_GAME" "${login[@]}" \
      +app_update "$STEAM_APPID" "${validate[@]}" +quit ); then
    echo "sb: steamcmd exited nonzero (see its output above); for the paid client (251570) an" >&2
    echo "    anonymous login cannot work - set STEAMCMD_USER and retry." >&2
    exit 1
  fi
}

cmd_seed_from_steam() {
  local src="${STEAM_SEED_SOURCE:-$HOME/.local/share/Steam/steamapps/common/7 Days To Die}"
  [[ -f "$src/7DaysToDie.exe" ]] || die "seed source is not a 7DTD install: $src"
  assert_not_steam_owned "$BASE_GAME" "base game"
  if [[ -d "$BASE_GAME" && -f "$BASE_GAME/7DaysToDie.exe" ]]; then
    echo "sb: base already present at $BASE_GAME; delete it first to re-seed" >&2
    return 1
  fi
  mkdir -p "$(dirname "$BASE_GAME")"
  echo "seeding base from $src (reflink snapshot; bootstrap only)"
  copy_tree "$src" "$BASE_GAME" "seed base"
  echo "seeded $(date -u +%Y-%m-%dT%H:%M:%SZ) from $src" > "$BASE_GAME/.seed-from-steam"
}

# --- server commands -------------------------------------------------------

cmd_fetch_server_base() {
  local validate=()
  case "${1:-}" in
    --validate) validate=(-validate); echo "sb: steam data-file validation enabled (--validate)" >&2 ;;
    "") ;;
    *) usage_err "unknown fetch-server-base option '$1' (--validate)" ;;
  esac
  require_steamcmd
  require_appid "$SERVER_APPID" SERVER_APPID
  assert_not_steam_owned "$SERVER_BASE_GAME" "server base game"
  mkdir -p "$SERVER_BASE_GAME"
  if ! ( cd "$STEAMCMD_DIR" && ./steamcmd.sh +force_install_dir "$SERVER_BASE_GAME" \
      +login anonymous +app_update "$SERVER_APPID" "${validate[@]}" +quit ); then
    echo "sb: steamcmd exited nonzero (see its output above)" >&2
    exit 1
  fi
}

# The instance's contiguous 5-port block, derived from its name: ServerPort
# (game, UDP+TCP), +1 telnet, +2..+4 spare (the dedicated opens a few ephemeral
# ports around ServerPort; loadgen bots also join on ServerPort+2).
#
# Name-derived, not creation-ordered: `srv-lab` gets the same ports on every
# machine whatever was created before it, so a harness that records a port can
# reproduce the run elsewhere. A block another instance already recorded is
# skipped by a deterministic forward probe.
alloc_server_ports() {
  require_python
  "$SB_PY" "$SB_CONFIG" port-block "$1" --instances "$INSTANCES_DIR"
}

# Local player names this server admits as permission_level=0. Declared once at
# create time and read back from instance.env, never discovered by scanning
# whatever other instances exist: the same declaration must produce the same
# serveradmin.xml on any host.
default_server_admins() {
  local name="$1"
  case "$name" in
    srv-*) echo "client-${name#srv-}" ;;
    *)     echo "" ;;
  esac
}

# A Local admin name reaches two destinations: serveradmin.xml (escaped) and
# instance.env (shell). instance.env is documented as source-able and `sb env`
# prints it for eval, so a name carrying shell metacharacters would be executed
# by the next harness. Charset-identical to an instance name, no exceptions.
validate_admin_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
    || usage_err "invalid admin name '$1' (use [A-Za-z0-9._-], not starting with '-')"
}

cmd_create_server() {
  # Shifted, so "$@" below is the --admin extras and not the instance name
  # itself: without this the server declared its own name as a Local admin.
  local name="$1"; shift || true
  validate_name "$name"
  [[ -d "$SERVER_BASE_GAME" && -f "$SERVER_BASE_GAME/7DaysToDieServer.x86_64" ]] \
    || die "server base missing at $SERVER_BASE_GAME (run 'sb fetch-server-base' first)"
  assert_not_steam_owned "$INSTANCES_DIR" "instances"
  local inst="$INSTANCES_DIR/$name"
  assert_contract_safe_root "$inst"
  [[ -e "$inst" ]] && die "instance '$name' already exists at $inst"
  # Validated and assembled before the directory exists, so a refused name
  # exits 2 with nothing written rather than through the rollback below.
  local admins extra
  admins="$(default_server_admins "$name")"
  for extra in "$@"; do
    validate_admin_name "$extra"
    admins="${admins:+$admins,}$extra"
  done
  mkdir -p "$inst"
  # Before the copy, so nothing the body writes below is ever published under
  # the umask.
  restrict_instance_dir "$inst"
  # Owned until the body below succeeds, so an interrupt during the copy takes
  # the partial tree with it; the rollback below covers the paths that fail on
  # their own.
  sb_own_pending "$inst"
  # Everything past this point works on a directory nothing else has claimed
  # yet. A failure anywhere in it (a copy that ran out of space, a seeding
  # error) would otherwise leave an instance dir that refuses every retry with
  # "already exists" and has to be removed by hand. The subshell keeps `die`
  # from ending the whole run, so the rollback is reachable.
  if ! (
    set -e
    create_server_body "$inst" "$name" "$admins"
  ); then
    rm -rf "$inst"
    sb_release_pending "$inst"
    die "server instance '$name' was not created; the partial tree at $inst is removed"
  fi
  sb_release_pending "$inst"
  # Read back through the same validation the bring-up runs, so the range this
  # reports is the range the server will be given, and the block's last port
  # comes from the one constant rather than a literal offset.
  local port
  instance_server_ports "$inst"
  port="$SERVER_PORT"
  echo "server instance '$name' created at $inst (ports ${port}..$(( port + PORT_BLOCK_LAST_OFFSET )))"
}

# The body of cmd_create_server, run in a subshell so the caller can roll the
# instance directory back when any step of it fails.
create_server_body() {
  local inst="$1" name="$2" admins="$3"
  local port
  port="$(alloc_server_ports "$name")"
  echo "copying server base into instance (reflink/COW)..."
  copy_tree "$SERVER_BASE_GAME" "$inst/game" "server base game"
  prune_instance_mods "$inst"
  mkdir -p "$inst/userdata/Saves" "$inst/userdata/Logs" "$inst/logs"
  write_platform "$inst/game/platform.cfg" Steam
  # Written before seeding and rendering: both read their declaration back
  # from this file, so the instance is described in one place.
  {
    cat <<EOF
# 7dtd-client-sandbox server instance contract (source or eval this file).
# Written by 'sb create-server'; consumed by 'sb launch-server' and siblings.
# SERVER_PORT is derived from SANDBOX_NAME, so the same name yields the same
# block on any machine. SERVER_ADMINS lists the Local player names this server
# admits at permission_level=0; edit it and relaunch to change them.
EOF
    env_line SANDBOX_NAME "$name"
    env_line INSTANCE_DIR "$inst"
    env_line SERVER_GAME "$inst/game"
    env_line SERVER_USERDATA "$inst/userdata"
    env_line SERVER_PORT "$port"
    env_line SERVER_TELNET_PORT "$(( port + 1 ))"
    env_line SERVER_CONFIG "$inst/serverconfig.xml"
    env_line SERVER_PROPS "$inst/instance.props"
    env_line SERVER_LOG "$inst/logs/server.log"
    env_line SERVER_ADMINS "$admins"
    env_line SERVER_KIND server
  } > "$inst/instance.env"
  : > "$inst/instance.props"
  seed_sandbox_admins "$inst"
}

cmd_launch_server() {
  local name="$1"; shift || true
  local inst
  inst="$(instance_dir "$name")"
  [[ -f "$inst/instance.env" ]] || die "'$name' is not a server instance (missing instance.env)"
  [[ "$(env_value "$inst" SERVER_KIND)" == server ]] || die "'$name' is a client instance; use 'sb launch'"
  local game="$inst/game"
  instance_server_ports "$inst"
  local port="$SERVER_PORT" telnet_port="$SERVER_TELNET_PORT"
  mkdir -p "$inst/userdata/Saves" "$inst/userdata/Logs" "$inst/logs"
  local cfg
  apply_server_config "$inst" "$name" "$port" "$telnet_port"
  cfg="$APPLIED_CONFIG"
  seed_sandbox_admins "$inst"
  echo "sandbox:   $name (server)"
  echo "game:      $game"
  echo "port:      $port (telnet $telnet_port)"
  echo "userdata:  $inst/userdata"
  echo "log:       $inst/logs/server.log"
  cd "$game"
  exec env SB_INSTANCE="$inst" \
    LD_LIBRARY_PATH="$(collect_mods_native_path "$game")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
    ./7DaysToDieServer.x86_64 -configfile="$cfg" -logfile "$inst/logs/server.log" \
    -dedicated -nographics -batchmode "$@"
}


# Native libraries shipped inside modlets (<mod>/Native, the 7dtd-wasm bridge
# ships libwasmtime.so there). The Mono resolver only sees the loader search
# path captured at process start, so every server bring-up prepends each
# staged modlet's Native dir to LD_LIBRARY_PATH before exec. Derived from the
# instance's own Mods tree, never the caller's environment.
collect_mods_native_path() {
  local mods="$1/Mods" entry out=""
  [[ -d "$mods" ]] || return 0
  for entry in "$mods"/*/Native; do
    [[ -d "$entry" ]] || continue
    out="${out:+$out:}$entry"
  done
  printf '%s' "$out"
}

# Properties an instance owns. A caller may not declare these: the instance
# allocated the ports and owns the userdata path, and a serverconfig that
# disagrees would send every harness at a port the server never binds.
INSTANCE_OWNED_PROPS="ServerPort TelnetPort UserDataFolder"

# A declaration is KEY=VALUE, one line. The stock serverconfig names its
# properties [A-Za-z_][A-Za-z0-9_]*; anything else is a name the game never
# reads, and a key carrying a regex metacharacter also breaks the upsert that
# rewrites instance.props. A value with a line break would inject a second
# declaration, and a value that is not UTF-8 cannot be written into the rendered
# config at all, so both are refused at the point it is written rather than at
# the next launch, when the reason is a file and a line number nobody remembers.
validate_prop() { # validate_prop <KEY=VALUE> [where]
  local kv="$1" where="${2:-bad property}" key value
  [[ "$kv" == *=* ]] || usage_err "$where: '$kv' is not KEY=VALUE"
  key="${kv%%=*}"
  value="${kv#*=}"
  prop_key_ok "$key" \
    || usage_err "$where: key '$key' must match [A-Za-z_][A-Za-z0-9_]* (e.g. MaxSpawnedZombies=0)"
  case "$value" in
    *$'\n'*|*$'\r'*) usage_err "$where: the value of '$key' spans a line break; a declaration is one line" ;;
  esac
  # The value is written into instance.props, read back here, and rendered into
  # a UTF-8 XML attribute. A byte that is not valid UTF-8 survives all of that
  # until the renderer encodes the file, so the declaration would be recorded
  # now and refused at every later render, leaving an instance that cannot apply
  # its own declared state. Refused where the caller can still see the key.
  # iconv is in the runtime image; without it the value is accepted and the
  # render names it, as before.
  if command -v iconv >/dev/null 2>&1; then
    printf '%s' "$value" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 \
      || usage_err "$where: the value of '$key' is not valid UTF-8"
  fi
}

# The instance's port block, read from its own declaration. Both keys must be
# present, in range and adjacent: a config that disagrees with instance.env sends
# every harness at a port the server never binds, and a missing
# SERVER_TELNET_PORT leaves the dedicated with no telnet at all. Refused here,
# before the server is started, rather than by whatever the harness finds first.
#
# The range check bounds the block's last port, since +1 and +2..+4 are ports
# the server binds too. It also compares digits rather than trusting the shell's
# arithmetic: a declaration wider than intmax_t (SERVER_PORT=9223372036854775808)
# wraps to a negative value and satisfied `<= 65535`, so the server was rendered
# with a negative ServerPort. The regex admits no leading zeros, so a length
# bound is an exact prefilter and the numeric compare only ever sees 1..99999.
instance_server_ports() { # instance_server_ports <inst>; sets SERVER_PORT and SERVER_TELNET_PORT
  local inst="$1"
  # Through env_value, so a hand-edited duplicate resolves the way every other
  # reader resolves it: last declaration wins. Reading the first line here made
  # the server bind one port while `sb env` handed the harness the other, and
  # the harness then missed a port nothing was listening on.
  SERVER_PORT="$(env_value "$inst" SERVER_PORT)"
  SERVER_TELNET_PORT="$(env_value "$inst" SERVER_TELNET_PORT)"
  [[ "$SERVER_PORT" =~ ^[1-9][0-9]*$ ]] \
    || die "no valid SERVER_PORT in $inst/instance.env (recreate the instance)"
  if [[ ${#SERVER_PORT} -gt ${#PORT_MAX} ]] \
    || (( SERVER_PORT + PORT_BLOCK_LAST_OFFSET > PORT_MAX )); then
    die "SERVER_PORT=$SERVER_PORT leaves its ${PORT_BLOCK_SIZE}-port block \
($SERVER_PORT..$(( SERVER_PORT + PORT_BLOCK_LAST_OFFSET ))) outside 1..$PORT_MAX in $inst/instance.env"
  fi
  [[ "$SERVER_TELNET_PORT" =~ ^[1-9][0-9]*$ ]] \
    || die "no valid SERVER_TELNET_PORT in $inst/instance.env (recreate the instance)"
  (( SERVER_TELNET_PORT == SERVER_PORT + 1 )) \
    || die "SERVER_TELNET_PORT=$SERVER_TELNET_PORT is not SERVER_PORT+1 in $inst/instance.env"
}

# Rebuild the instance serverconfig from the pristine base template plus the
# properties declared in instance.props. Rebuilt, never edited in place: an
# in-place edit accumulates, so a suite that sets MaxSpawnedZombies=0 would
# leave it set for the next suite that says nothing about spawns. Config is a
# pure function of (base template, declared props, instance identity).
#
# The rendered path is returned in APPLIED_CONFIG rather than on stdout: every
# caller wants it through a command substitution, and a refusal inside one
# would exit the subshell and hand the caller an empty path, which the server
# would then run with as `-configfile=`. That is the fail-open this shape
# exists to prevent.
#
# Shared by launch-server, `up` and `run both` so the bring-up paths cannot
# drift.
apply_server_config() {
  local inst="$1" name="$2" port="$3" telnet_port="$4"
  local cfg="$inst/serverconfig.xml"
  local args=() line lineno=0
  if [[ -f "$inst/instance.props" ]]; then
    # `|| [[ -n "$line" ]]`: instance.props is hand-editable, and a last line
    # with no trailing newline is a declaration read, not one dropped.
    while IFS= read -r line || [[ -n "$line" ]]; do
      lineno=$(( lineno + 1 ))
      [[ -z "$line" || "$line" == \#* ]] && continue
      validate_prop "$line" "$inst/instance.props:$lineno"
      args+=(--set "$line")
    done < "$inst/instance.props"
  fi
  # Instance-owned values go last so a declared property cannot win over them.
  require_python
  "$SB_PY" "$SB_CONFIG" render "$inst/game/serverconfig.xml" "$cfg" \
    --userdata "$inst/userdata" \
    "${args[@]}" \
    --set "ServerPort=$port" \
    --set "TelnetPort=$telnet_port" \
    --set "ServerName=sandbox-$name" \
    --set "EACEnabled=false" >/dev/null \
    || die "could not render $cfg from $inst/game/serverconfig.xml"
  APPLIED_CONFIG="$cfg"
}

# Record declared properties into instance.props (upsert by key, last write
# wins) so the next render includes them. Returns the file path.
#
# instance.props is a line format, so a value may not contain a newline: one
# would be read back as a second declaration, and the render would then fail
# on a fragment that is not KEY=VALUE. Refused here, at the point the caller
# can still see which key it was.
record_server_props() {
  local inst="$1"; shift
  local props="$inst/instance.props" kv key owned
  (($#)) || return 0
  # Every declaration is checked before any of them is written. Upserting one
  # key at a time recorded the keys ahead of a refused one and stopped there,
  # so `render-config GameWorld=Navezgane ServerPort=1` exited 2 and left
  # GameWorld declared: the file and the rendered config disagreed, and the
  # declaration the caller was told had not applied took effect on the next
  # launch. A refusal now leaves instance.props exactly as it was.
  for kv in "$@"; do
    validate_prop "$kv"
    key="${kv%%=*}"
    for owned in $INSTANCE_OWNED_PROPS; do
      [[ "$key" == "$owned" ]] && usage_err "$key is owned by the instance, not a caller (it allocated the ports and userdata path)"
    done
  done
  # Upsert by literal prefix, read in the shell rather than through grep:
  # a key carrying `.`, `*` or `[` used to match (and drop) every other
  # declaration, losing the instance's whole declared state to one
  # `sb render-config` call. A newline in the value is refused by
  # validate_prop above: one declaration is one line.
  #
  # One rewrite for the whole call, into a per-pid temp that is removed on
  # every failure path, an interrupt included: the per-key rewrite left an
  # instance.props.tmp behind when it died mid-loop, and every concurrent call
  # wrote the same temp name, so two harnesses declaring at once published a
  # blend of both.
  touch "$props"
  local -a drops=() kept=()
  local drop line tmp
  for kv in "$@"; do drops+=("${kv%%=*}="); done
  while IFS= read -r line || [[ -n "$line" ]]; do
    local superseded=0
    for drop in "${drops[@]}"; do
      if [[ "$line" == "$drop"* ]]; then superseded=1; break; fi
    done
    (( superseded )) || kept+=("$line")
  done < "$props"
  kept+=("$@")
  tmp="$props.tmp.$$"
  sb_own_pending "$tmp"
  if ! printf '%s\n' "${kept[@]}" > "$tmp"; then
    rm -f "$tmp"
    die "could not write $tmp"
  fi
  # Restricted before the rename, like sbconfig.py's _atomic_write: the
  # declarations reach serverconfig.xml, which is kept 0600 because a rendered
  # config can carry TelnetPassword, and that password is declared here. A temp
  # created by the shell redirect carries the umask (0644 under the usual 022),
  # so a `sb render-config <n> TelnetPassword=...` published the one file on the
  # instance that could not be read back by the caller it was protecting.
  if ! chmod 0600 "$tmp" 2>/dev/null; then
    warn "could not restrict $tmp to 0600 (check the filesystem's mode support)"
  fi
  if ! mv "$tmp" "$props"; then
    rm -f "$tmp"
    die "could not install $props"
  fi
  # Sorted by byte, not by the caller's collation: the declared order is what
  # apply_server_config turns into --set arguments, so it fixes the order of the
  # properties in the rendered serverconfig. Under a UTF-8 locale sort places
  # `alpha` before `Bravo` and ignores punctuation, so the same declarations
  # rendered a different serverconfig.xml on a machine with a different locale.
  LC_ALL=C sort -o "$props" "$props"
}

# --- commands --------------------------------------------------------------

cmd_init() {
  mkdir -p "$INSTANCES_DIR" "$SANDBOX_HOME/base"
  # detect_proton dies, which is right for a create and wrong for the report
  # that exists to tell an operator what sb resolved: on a host with no Proton
  # yet, `sb doctor` could not print a single line. The refusal is reported and
  # execution continues; every path that launches a client still refuses.
  # `die` exits, so it is the assignment's status that needs the `|| true`.
  [[ -n "${PROTON:-}" ]] || PROTON="$(detect_proton || true)" || true
  # Every value this process resolved, so the configuration a run will use is
  # readable from the tool rather than only from this file. Nothing here is a
  # credential: the one secret-shaped variable in the tree (STEAMCMD_PASS) is
  # refused at fetch, and STEAMCMD_USER is a name the fetch path prompts for.
  echo "SANDBOX_HOME=$SANDBOX_HOME"
  echo "INSTANCES_DIR=$INSTANCES_DIR"
  echo "BASE_GAME=$BASE_GAME"
  echo "SERVER_BASE_GAME=$SERVER_BASE_GAME"
  echo "STEAMCMD_DIR=$STEAMCMD_DIR"
  echo "PROTON=${PROTON:-not found (set PROTON=/path/to/proton)}"
  echo "STEAM_ROOT=$STEAM_ROOT"
  echo "STEAM_APPID=$STEAM_APPID"
  echo "SERVER_APPID=$SERVER_APPID"
  echo "SB_CONFIG=$SB_CONFIG"
  # The defaults `sb create` records and `sb up` waits, so a run's numbers can
  # be read here rather than looked up in this file.
  echo "SB_DEFAULT_RES=$SB_DEFAULT_RES"
  echo "SB_DEFAULT_FULLSCREEN=$SB_DEFAULT_FULLSCREEN"
  echo "SB_UP_TIMEOUT=${SB_UP_TIMEOUT}s"
  echo "steamcmd: $([ -x "$STEAMCMD_DIR/steamcmd.sh" ] && echo ok || echo missing)"
  # Readiness report, so a bad interpreter is named here rather than by the
  # first create/up that shells out to sbconfig.py.
  if command -v "$SB_PY" >/dev/null 2>&1; then
    echo "python:   $("$SB_PY" -V 2>&1) (need $SB_PY_MIN+)"
  else
    echo "python:   missing ($SB_PY not on PATH; need $SB_PY_MIN+)"
  fi
}

cmd_doctor() {
  cmd_init
  echo "--- client base ---"
  if [[ -d "$BASE_GAME" && -f "$BASE_GAME/7DaysToDie.exe" ]]; then
    du -sh "$BASE_GAME" 2>/dev/null || true
  else
    echo "client base missing; run 'sb fetch-base'"
  fi
  echo "--- server base ---"
  if [[ -d "$SERVER_BASE_GAME" && -f "$SERVER_BASE_GAME/7DaysToDieServer.x86_64" ]]; then
    du -sh "$SERVER_BASE_GAME" 2>/dev/null || true
  else
    echo "server base missing; run 'sb fetch-server-base'"
  fi
  echo "--- base mods ---"
  # A base seeded from a Steam install carries whatever that install had. An
  # instance prunes those, so a run is not broken by them, but a contaminated
  # base is still worth naming: it makes every fresh instance do that work, and
  # it means the base is not the pristine depot the isolation story claims.
  local b label
  for b in "$BASE_GAME:client" "$SERVER_BASE_GAME:server"; do
    label="${b##*:}"
    b="${b%%:*}"
    [[ -d "$b/Mods" ]] || continue
    local extra=() entry name
    for entry in "$b/Mods"/*; do
      [[ -e "$entry" ]] || continue
      name="${entry##*/}"
      is_stock_mod "$name" || extra+=("$name")
    done
    if (( ${#extra[@]} )); then
      echo "$label base ships: ${extra[*]}"
      echo "      instances prune these; a pair must run one mod set, and the two"
      echo "      depots ship different samples. Declare any you need as a staged mod."
    else
      echo "$label base: Harmony loader only"
    fi
  done
  echo "--- reflink ---"
  local probe="$SANDBOX_HOME/base/.reflink_probe"
  if cp --reflink=always "$BASE_GAME/7DaysToDie.exe" "$probe" 2>/dev/null; then
    echo "btrfs reflink available (cheap COW copies)"
  else
    echo "reflink unavailable (instances will be plain copies)"
  fi
  rm -f "$probe"
  echo "--- platform.cfg in client base ---"
  [[ -f "$BASE_GAME/platform.cfg" ]] && cat "$BASE_GAME/platform.cfg"
  echo "--- steam ownership guard ---"
  assert_not_steam_owned "$BASE_GAME" "client base" && echo "client base: not Steam-owned (Steam will never verify it)"
  assert_not_steam_owned "$SERVER_BASE_GAME" "server base" && echo "server base: not Steam-owned (Steam will never verify it)"
  assert_not_steam_owned "$INSTANCES_DIR" "instances" && echo "instances: not Steam-owned (Steam will never verify them)"
}

cmd_create() {
  local name="$1"; shift || true
  local res="${SB_RES:-$SB_DEFAULT_RES}" fullscreen="${SB_FULLSCREEN:-$SB_DEFAULT_FULLSCREEN}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --res) shift; [[ $# -gt 0 ]] || usage_err "--res needs WIDTHxHEIGHT"; res="$1" ;;
      --fullscreen) shift; [[ $# -gt 0 ]] || usage_err "--fullscreen needs 0 or 1"; fullscreen="$1" ;;
      *) usage_err "unknown create option '$1' (--res WxH | --fullscreen 0|1)" ;;
    esac
    shift
  done
  validate_window "$res" "$fullscreen"
  validate_name "$name"
  require_base
  assert_not_steam_owned "$INSTANCES_DIR" "instances"
  assert_not_steam_owned "$BASE_GAME" "base game"
  local inst="$INSTANCES_DIR/$name"
  assert_contract_safe_root "$inst"
  [[ -e "$inst" ]] && die "instance '$name' already exists at $inst"
  PROTON="$(detect_proton)"
  mkdir -p "$inst"
  # Before the copy, so nothing the body writes below is ever published under
  # the umask.
  restrict_instance_dir "$inst"
  # Owned until the body below succeeds, so an interrupt during the copy takes
  # the partial tree with it.
  sb_own_pending "$inst"
  # Rolled back on failure for the same reason as create_server: a half-built
  # instance dir refuses every retry with "already exists".
  if ! (
    set -e
    create_client_body "$inst" "$name" "$res" "$fullscreen"
  ); then
    rm -rf "$inst"
    sb_release_pending "$inst"
    die "instance '$name' was not created; the partial tree at $inst is removed"
  fi
  sb_release_pending "$inst"
  echo "created instance '$name' at $inst"
}

# The body of cmd_create, run in a subshell so the caller can roll the instance
# directory back when any step of it fails.
create_client_body() {
  local inst="$1" name="$2" res="$3" fullscreen="$4"
  echo "copying base game into instance (reflink/COW)..."
  copy_tree "$BASE_GAME" "$inst/game" "base game"
  prune_instance_mods "$inst"
  write_platform "$inst/game/platform.cfg" Local
  mkdir -p "$inst/compatdata" "$inst/logs"
  {
    cat <<EOF
# 7dtd-client-sandbox instance contract (source or eval this file).
# Written by 'sb create'; consumed by 'sb launch' and sibling harnesses.
# SB_RES / SB_FULLSCREEN are this instance's window, declared here rather than
# read from the caller's environment, so the same instance opens the same
# window on any machine. Edit them and relaunch to change it.
EOF
    env_line SANDBOX_NAME "$name"
    env_line INSTANCE_DIR "$inst"
    env_line GAME "$inst/game"
    env_line COMPAT "$inst/compatdata"
    env_line PROTON "$PROTON"
    env_line STEAM_ROOT "$STEAM_ROOT"
    env_line STEAM_APPID "$STEAM_APPID"
    env_line LOGFILE "$inst/logs/output_log_client.txt"
    env_line SB_RES "$res"
    env_line SB_FULLSCREEN "$fullscreen"
  } > "$inst/instance.env"
  restrict_instance_env "$inst"
  echo "initializing Proton prefix (first run; one-time cost)..."
  if ( cd "$inst/game" \
       && env STEAM_COMPAT_DATA_PATH="$inst/compatdata" \
              STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT" \
              "$PROTON" run wineboot.exe -u >/dev/null 2>&1 ); then
    echo "prefix initialized"
  else
    warn "wineboot init failed; the prefix will be created on first 'sb launch'"
  fi
  seed_offline_prefs "$inst"
  link_prefix_logs "$inst"
}

# Seconds a TERMed instance is given to exit before it is KILLed. Long enough
# for the dedicated to flush its world and close its userdata, short enough
# that a caller tearing down a wedged instance is not held up by it.
TERM_GRACE_SEC=3

# How long a bring-up waits for the game port to accept, when the caller named
# no --timeout. `sb up` is the harness form, so its default is the generous
# one; `sb run both` launches a client behind the same wait, so it uses the
# shorter one and says so on failure.
UP_PORT_WAIT_SEC=180
RUN_BOTH_PORT_WAIT_SEC=90

# TERM, then KILL whatever is still standing, for every process bound to this
# instance. The one teardown every path shares: `stop`, `destroy`, and the
# bring-up paths that must not abandon a server they started. Nothing else
# matches by pattern, so one instance's teardown never touches another's.
terminate_instance() {
  local inst="$1"
  local pids
  mapfile -t pids < <(instance_procs "$inst")
  (( ${#pids[@]} )) || return 0
  echo "stopping instance (pids: ${pids[*]})"
  kill -TERM "${pids[@]}" 2>/dev/null || true
  sleep "$TERM_GRACE_SEC"
  mapfile -t pids < <(instance_procs "$inst")
  if (( ${#pids[@]} > 0 )); then
    echo "still alive, sending KILL: ${pids[*]}"
    kill -KILL "${pids[@]}" 2>/dev/null || true
  fi
}

cmd_destroy() {
  local name="$1" inst
  validate_name "$name"
  inst="$INSTANCES_DIR/$name"
  # Teardown is re-run: a harness whose previous pass died, or whose caller
  # invokes the teardown unconditionally, destroys an instance that is already
  # gone. That is done, not failed, and `instance_dir`'s exit 2 made it a
  # failed one, which also stopped `sb destroy a b` at the first name that was
  # already gone and left the rest of the list standing.
  if [[ ! -d "$inst" ]]; then
    echo "sb: instance '$name' is not there"
    return 0
  fi
  if [[ -n "$(instance_procs "$inst")" ]]; then
    echo "sb: instance '$name' is running; stopping it first" >&2
    terminate_instance "$inst"
  fi
  rm -rf "$inst"
  echo "destroyed instance '$name'"
}

cmd_wipe() {
  local name="$1" inst kind
  inst="$(instance_dir "$name")"
  kind="$(instance_kind "$inst")"
  local pids
  pids="$(instance_procs "$inst")"
  if [[ -n "$pids" ]]; then
    die "instance '$name' is running (pids: ${pids//$'\n'/ }); stop it first ('sb stop $name')"
  fi
  if [[ "$kind" == server ]]; then
    [[ -f "$SERVER_BASE_GAME/7DaysToDieServer.x86_64" ]] || die "server base missing (run 'sb fetch-server-base')"
    copy_tree "$SERVER_BASE_GAME" "$inst/game" "server base game"
    prune_instance_mods "$inst"
    write_platform "$inst/game/platform.cfg" Steam
    rm -rf "$inst/userdata"
    mkdir -p "$inst/userdata/Saves" "$inst/userdata/Logs"
    seed_sandbox_admins "$inst"
    # The declared properties go with the state they configured: a wiped
    # instance is the base template again, not the last suite's world.
    rm -f "$inst/serverconfig.xml"
    : > "$inst/instance.props"
    echo "wiped server instance '$name': game, Mods, userdata and declared config reset to base"
    return 0
  fi
  require_base
  copy_tree "$BASE_GAME" "$inst/game" "base game"
  prune_instance_mods "$inst"
  write_platform "$inst/game/platform.cfg" Local
  restrict_instance_dir "$inst"
  seed_offline_prefs "$inst"
  local roam="$inst/compatdata/pfx/drive_c/users/steamuser/AppData/Roaming/7DaysToDie"
  rm -rf "$roam/Saves" "$roam/SavesLocal" "$roam/GeneratedWorlds" 2>/dev/null || true
  echo "wiped instance '$name': game, Mods and saves reset to pristine base"
}

instance_running() {
  local -a pids
  mapfile -t pids < <(instance_procs "$1")
  (( ${#pids[@]} )) && echo "yes (${#pids[@]} procs)" || echo "no"
}

cmd_list() {
  [[ -d "$INSTANCES_DIR" ]] || { echo "(no instances; run 'sb create <name>')"; return 0; }
  # One /proc pass for every instance, not one per row: the running state of
  # each instance is one more marker for the same scan.
  local d name kind marker pid i count running
  local -a dirs=() names=() kinds=() markers=()
  for d in "$INSTANCES_DIR"/*/; do
    [[ -d "$d" ]] || continue
    d="${d%/}"
    dirs+=("$d")
    names+=("${d##*/}")
    kind="$(instance_kind "$d")"
    kinds+=("$kind")
    marker="$(instance_marker "$d")"
    markers+=("$marker")
  done
  ((${#dirs[@]})) || { echo "(no instances; run 'sb create <name>')"; return 0; }
  declare -A counts=()
  while IFS=$'\t' read -r marker pid; do
    counts["$marker"]=$(( ${counts["$marker"]:-0} + 1 ))
  done < <(pids_for_markers "${markers[@]}")
  for i in "${!dirs[@]}"; do
    count="${counts[${markers[i]}]:-0}"
    if (( count )); then running="yes ($count procs)"; else running="no"; fi
    printf '%-20s %-8s %-16s %s\n' "${names[i]}" "${kinds[i]}" "$running" "${dirs[i]}"
  done
}

cmd_status() {
  local name="$1" inst kind
  inst="$(instance_dir "$name")"
  kind="$(instance_kind "$inst")"
  echo "instance:   $name ($kind)"
  echo "dir:        $inst"
  echo "running:    $(instance_running "$inst")"
  echo "game:       $inst/game  ($(du -sh "$inst/game" 2>/dev/null | cut -f1))"
  if [[ "$kind" == server ]]; then
    echo "userdata:   $inst/userdata"
    echo "log:        $inst/logs/server.log"
    echo "mods:       $inst/game/Mods"
  else
    echo "compatdata: $inst/compatdata"
    echo "log:        $inst/logs/output_log_client.txt"
    echo "mods:       $inst/game/Mods"
  fi
  echo "--- instance.env ---"
  cat "$inst/instance.env" 2>/dev/null || true
}

# One `export K=V` line on stdout, the value quoted: the documented consumer
# is `eval "$(sb env <name>)"`, so a path or a declared value carrying a quote
# or a command substitution would otherwise run in the caller's shell. The key
# needs no quoting: `cmd_env` passes the fixed names below, and every key read
# out of instance.env is dropped unless it already matches [A-Za-z_][A-Za-z0-9_]*.
emit_export() {
  shquote "$2"
  printf 'export %s=%s\n' "$1" "$REPLY"
}

cmd_env() {
  local name="$1" inst kind
  inst="$(instance_dir "$name")"
  kind="$(instance_kind "$inst")"
  if [[ "$kind" == server ]]; then
    # A bare `KEY=value` line defines a shell variable but does not export it,
    # so a server contract read this way was invisible to every child process a
    # sibling harness spawned.
    local key value line
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -z "$line" || "$line" == \#* ]] && continue
      [[ "$line" == *=* ]] || continue
      key="${line%%=*}"; value="${line#*=}"
      [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
      # env_line wrote the value quoted, so take that one layer off before
      # quoting it again for the caller: exporting a quoted value would hand
      # the caller the quotes as part of the string.
      emit_export "$key" "$(unquote_value "$value")"
    done < "$inst/instance.env"
    return 0
  fi
  PROTON="$(detect_proton)"
  # Read and validated here rather than in a command substitution: a refusal
  # must exit `sb` itself, not a subshell, which would hand the caller a client
  # with no window arguments at all.
  local res fullscreen win_args
  read -r res fullscreen < <(declared_window "$inst")
  validate_window "$res" "$fullscreen"
  win_args="$(screen_args "$res" "$fullscreen")"
  emit_export SANDBOX_NAME "$name"
  emit_export INSTANCE_DIR "$inst"
  emit_export GAME "$inst/game"
  emit_export COMPAT "$inst/compatdata"
  emit_export PROTON "$PROTON"
  emit_export STEAM_ROOT "$STEAM_ROOT"
  emit_export STEAM_APPID "$STEAM_APPID"
  emit_export LOGFILE "$inst/logs/output_log_client.txt"
  emit_export SB_RES "$res"
  emit_export SB_FULLSCREEN "$fullscreen"
  emit_export SB_SCREEN_ARGS "$win_args"
}

cmd_launch() {
  local name="$1"; shift || true
  local inst
  inst="$(instance_dir "$name")"
  if [[ "$(instance_kind "$inst")" == server ]]; then
    die "'$name' is a server instance; use 'sb launch-server $name'"
  fi
  local game="$inst/game" compat="$inst/compatdata"
  [[ -d "$game" ]] || die "instance '$name' game missing at $game (recreate or wipe)"
  PROTON="$(detect_proton)"
  ensure_local_platform "$game"
  mkdir -p "$inst/logs"
  # Every client bring-up, so an instance created before the guard existed has
  # its prefix and logs restricted too, not only the ones created after it.
  restrict_instance_dir "$inst"
  link_prefix_logs "$inst"
  export STEAM_COMPAT_DATA_PATH="$compat"
  export STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT"
  export SteamAppId="$STEAM_APPID"
  export SteamGameId="$STEAM_APPID"
  local player
  player="$(printenv 7DTD_PLAYER_NAME 2>/dev/null || true)"
  [[ -n "$player" ]] || player="$name"
  local gfx_api="${GFX_API:-d3d11}"
  local gfx
  case "$gfx_api" in
    d3d11|d3d12|vulkan|glcore) gfx=(-force-"$gfx_api") ;;
    none) gfx=() ;;
    *) die "GFX_API must be d3d11, d3d12, vulkan, glcore or none (got '$gfx_api')" ;;
  esac
  local win_args=()
  if ! has_screen_arg "$@"; then
    local res fullscreen
    read -r res fullscreen < <(declared_window "$inst")
    validate_window "$res" "$fullscreen"
    read -r -a win_args < <(screen_args "$res" "$fullscreen")
  fi
  # The prefix's logs dir is a symlink to $inst/logs (link_prefix_logs), so
  # this name is the host path instance.env declares as LOGFILE and the one
  # `sb logs`, `sb status` and a sibling harness reading $LOGFILE look for.
  local win_log="C:/users/steamuser/AppData/Roaming/7DaysToDie/logs/output_log_client.txt"
  echo "sandbox:   $name"
  echo "proton:    $PROTON"
  echo "game:      $game"
  echo "compat:    $compat"
  echo "log:       $inst/logs/output_log_client.txt"
  echo "player:    $player"
  echo "window:    ${win_args[*]:-<as passed>}"
  cd "$game"
  exec env 7DTD_PLAYER_NAME="$player" "$PROTON" run ./7DaysToDie.exe "${gfx[@]}" -nogs -noeac -skipintro -SkipNewsScreen=true \
    -logfile "$win_log" "${win_args[@]}" "$@"
}

cmd_stop() {
  local name="$1" inst
  validate_name "$name"
  inst="$INSTANCES_DIR/$name"
  local pids=()
  if [[ -d "$inst" ]]; then
    mapfile -t pids < <(instance_procs "$inst")
  fi
  if ((${#pids[@]} == 0)); then
    echo "sb: instance '$name' is not running" >&2
    return 0
  fi
  echo "stopping instance '$name'"
  terminate_instance "$inst"
  echo "stopped"
}

cmd_logs() {
  local name="$1" inst kind follow=""
  [[ $# -ge 1 ]] && shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=1 ;;
      *) usage_err "unknown logs option '$1' (-f | --follow)" ;;
    esac
    shift
  done
  inst="$(instance_dir "$name")"
  kind="$(instance_kind "$inst")"
  local logfile
  if [[ "$kind" == server ]]; then
    logfile="$inst/logs/server.log"
  else
    logfile="$inst/logs/output_log_client.txt"
  fi
  [[ -f "$logfile" ]] || die "no log yet at $logfile"
  if [[ -n "$follow" ]]; then
    tail -f "$logfile"
  else
    tail -n 40 "$logfile"
  fi
}

# --- run: three-mode dispatcher -------------------------------------------

# A sandbox client is a test fixture, not a game session: it must never take
# the display fullscreen, and several of them have to be visible at once. The
# command line wins over whatever the prefix's saved prefs hold, which is why
# the window is passed at every launch rather than seeded into the registry,
# and `sb env` exports it so a launcher that is not `sb launch`
# (7dtd-fastconnect's launch_client.sh, used by 7dtd-playtest) applies the same
# window. A malformed declaration is a refusal, never a client with no window
# arguments.
validate_window() {
  local res="$1" fullscreen="$2"
  [[ "$res" =~ ^[0-9]+x[0-9]+$ ]] || die "SB_RES must look like 1920x1080 (got '$res')"
  case "$fullscreen" in 0|1) ;; *) die "SB_FULLSCREEN must be 0 or 1 (got '$fullscreen')" ;; esac
}

# True when the caller's game args already carry a -screen-* argument, so the
# declared window is not added on top. A bash scan rather than
# `printf '%s\0' | grep -z`: NUL-separated input is a GNU extension, and a
# client launch should not be the one path that needs it.
has_screen_arg() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      *-screen-*) return 0 ;;
    esac
  done
  return 1
}

# The window this instance declared, as "<res> <fullscreen>". Read from its
# instance.env, not from the caller's environment: the same instance must open
# the same window on any machine. An instance created before the window was
# declared falls back to SB_DEFAULT_RES / SB_DEFAULT_FULLSCREEN, which is what
# it was getting anyway.
# Pure: the caller validates, so a refusal exits `sb` rather than a subshell.
declared_window() {
  local inst="$1" res fullscreen
  res="$(env_value "$inst" SB_RES)"
  fullscreen="$(env_value "$inst" SB_FULLSCREEN)"
  [[ -n "$res" ]] || res="$SB_DEFAULT_RES"
  [[ -n "$fullscreen" ]] || fullscreen="$SB_DEFAULT_FULLSCREEN"
  echo "$res $fullscreen"
}

# The Unity window arguments every sandbox client launches with: windowed at
# the declared SB_RES (default 1280x720) unless SB_FULLSCREEN=1.
screen_args() {
  echo "-screen-fullscreen $2 -screen-width ${1%%x*} -screen-height ${1##*x}"
}

# The only mod an instance keeps unconditionally: the Harmony loader every code
# mod needs (workspace rule: code mods require stock 0_TFP_Harmony).
#
# TFP's sample modlets are deliberately NOT kept. The client and dedicated
# depots ship different ones (the server carries TFP_CommandExtensions and
# Xample_MarkersMod; the client carries neither), so keeping them makes every
# client/server pair asymmetric by construction: the server registers content
# the client never loaded, and the first world package it sends is unparseable.
# A suite that wants one stages it like any other modlet.
STOCK_MOD='0_TFP_Harmony'

# True when a Mods entry is stock, that is the one loader an instance always
# keeps. `sb doctor` reports the same set it prunes, so the two cannot drift
# into disagreeing about what "stock" means.
is_stock_mod() {
  [[ "$1" == "$STOCK_MOD" ]]
}

# An instance's Mods are the Harmony loader plus exactly what was declared.
#
# A base seeded from a Steam install carries whatever that install had. This
# repo's own client base carries RealEarth, so every client instance inherited
# a terrain mod the server instance did not: the pair registered different
# blocks, the client failed to deserialize the first world package and the
# server kicked it, minutes into a run, with nothing naming the cause.
#
# Pruning happens in the instance, never in the base (rule 1): the base stays
# the pristine depot copy, and what an instance runs stays a pure function of
# the depot's stock mods and the declaration.
prune_instance_mods() {
  local inst="$1" mods="$1/game/Mods" entry base removed=()
  [[ -d "$mods" ]] || return 0
  for entry in "$mods"/*; do
    [[ -e "$entry" ]] || continue
    base="${entry##*/}"
    is_stock_mod "$base" && continue
    rm -rf "$entry"
    removed+=("$base")
  done
  if (( ${#removed[@]} )); then
    echo "pruned undeclared mods: ${removed[*]}"
    echo "  (the base itself is untouched; stage what this instance needs)"
  fi
}

# Copy built modlets into an instance's game/Mods. Real copies, never
# symlinks: an instance is a self-contained tree, and a symlinked mod would
# make `sb wipe` and the base copy lie about what the instance runs.
stage_mods() {
  local inst="$1"; shift
  local src base
  mkdir -p "$inst/game/Mods"
  for src in "$@"; do
    [[ -d "$src" ]] || die "mod source is not a directory: $src"
    [[ -f "$src/ModInfo.xml" ]] || die "not a modlet (no ModInfo.xml): $src"
    base="$(basename "$src")"
    # Re-staging replaces what was there. Removing the old copy first made a
    # copy that failed part-way (an unreadable file under the modlet) leave the
    # instance with no mod at all, so a suite that had staged a working build
    # and re-staged a broken one lost the working one. copy_tree publishes by
    # rename, so the old mod survives a failed replacement intact.
    copy_tree "$src" "$inst/game/Mods/$base" "modlet $base"
    echo "staged $base into $inst/game/Mods"
  done
}

# The sibling 7dtd-fastconnect client mod, so `sb run both` can auto-join (the
# stock client ignores -connect=). A note instead of a failure when the sibling
# repo or its dist/ is absent: the client still launches and sits at the menu.
stage_fastconnect() {
  local inst="$1"
  local src="${FASTCONNECT_DIST:-$SANDBOX_HOME/../7dtd-fastconnect/dist/7dtd-fastconnect}"
  if [[ -f "$src/ModInfo.xml" ]]; then
    stage_mods "$inst" "$src"
  else
    warn "7dtd-fastconnect dist not found at $src; client will sit at the menu (no auto-join)"
  fi
}

# Start a server instance detached (its own session), config already rendered.
# Shared by `sb up` and `sb run both` so the detached path exists once.
start_server_detached() {
  local inst="$1" name="$2" port="$3" telnet_port="$4"
  local cfg
  mkdir -p "$inst/userdata/Saves" "$inst/userdata/Logs" "$inst/logs"
  # Truncated per start: the game rotates its own server.log, but this capture
  # is the sandbox's, and a suite that brings the same instance up hundreds of
  # times would grow it without bound. One start's output per file.
  : > "$inst/logs/server.stdout.log"
  apply_server_config "$inst" "$name" "$port" "$telnet_port"
  cfg="$APPLIED_CONFIG"
  seed_sandbox_admins "$inst"
  # `setsid --fork` (not a backgrounded `setsid ... &`): setsid forks the
  # server into a new session and exits immediately, so the server is orphaned
  # to init and this shell has no child left to wait on. Backgrounding it
  # instead left the server parented to `sb`, and `sb up` then sat in do_wait
  # forever after its port check had already passed. `sb run both` never saw
  # this because it execs the client over itself straight afterwards.
  ( cd "$inst/game" \
    && exec setsid --fork env SB_INSTANCE="$inst" \
         LD_LIBRARY_PATH="$(collect_mods_native_path "$inst/game")${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
         ./7DaysToDieServer.x86_64 \
           -configfile="$cfg" -logfile "$inst/logs/server.log" \
           -dedicated -nographics -batchmode \
        </dev/null >"$inst/logs/server.stdout.log" 2>&1 )
}

# Milliseconds since boot, read from the kernel. A deadline taken from the
# wall clock is not a duration: an NTP step forward ends the wait early, a
# step backward extends it by the size of the step, and neither is the
# --timeout the caller asked for. /proc/uptime counts uptime, is already a
# dependency of this script (instance_procs walks /proc/<pid>/environ), and
# carries centiseconds.
#
# The fraction is kept rather than truncated. floor(t) - floor(t0) is the true
# elapsed time only to within a second, and always biased early: a --timeout 3
# returned anywhere in (2s, 4s), a quarter of the deadline away from what the
# harness asked for. Milliseconds are one digit wider and cost nothing, since
# the kernel reports them either way.
monotonic_now() {
  local uptime whole frac
  read -r uptime _ </proc/uptime || die "cannot read /proc/uptime (needed for a monotonic timeout)"
  if [[ "$uptime" == *.* ]]; then
    whole="${uptime%%.*}"
    frac="000${uptime#*.}"
    frac="${frac: -3}"
  else
    whole="$uptime"
    frac=000
  fi
  printf '%s' "$(( whole * 1000 + 10#$frac ))"
}

# Block until a TCP port accepts connections, or die after a timeout. The
# server logs "Telnet on <port>" and starts listening on <port>+0 well
# before the world is fully generated; clients that auto-join usually finish
# loading by then too.
wait_for_port() {
  local host="$1" port="$2" timeout="${3:-$SB_UP_TIMEOUT}"
  local start deadline_ms
  # The caller's --timeout is seconds; the deadline is compared in the
  # milliseconds monotonic_now reports, so the wait is the duration asked for
  # and not one rounded to the second.
  deadline_ms=$(( timeout * 1000 ))
  start="$(monotonic_now)"
  while (( $(monotonic_now) - start < deadline_ms )); do
    # The connection is opened in a subshell, so the socket closes with it.
    if (exec 3<>/dev/tcp/"$host"/"$port") 2>/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}

# Bring a server instance up detached and block until its game port accepts
# connections. `sb run server` execs and blocks forever; harnesses need a
# bounded, exit-coded bring-up they can call and then drive. Teardown is
# `sb stop <name>` (same instance-scoped process match as every other path).
cmd_up() {
  local name="$1"; shift || true
  local timeout="$UP_PORT_WAIT_SEC"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) shift; [[ $# -gt 0 ]] || usage_err "--timeout needs a value"; timeout="$1" ;;
      *) usage_err "unknown up option '$1' (--timeout N)" ;;
    esac
    shift
  done
  [[ "$timeout" =~ ^[0-9]+$ ]] || usage_err "--timeout must be a whole number of seconds"
  validate_name "$name"
  ensure_instance "$name" cmd_create_server "$name" >/dev/null
  local inst="$INSTANCES_DIR/$name"
  [[ -f "$inst/instance.env" ]] || die "'$name' is not a server instance (missing instance.env)"
  [[ "$(env_value "$inst" SERVER_KIND)" == server ]] || die "'$name' is a client instance; use 'sb launch'"
  local pids
  pids="$(instance_procs "$inst")"
  [[ -n "$pids" ]] && die "instance '$name' is already running (pids: ${pids//$'\n'/ })"
  instance_server_ports "$inst"
  local port="$SERVER_PORT" telnet_port="$SERVER_TELNET_PORT"
  start_server_detached "$inst" "$name" "$port" "$telnet_port"
  if ! wait_for_port 127.0.0.1 "$port" "$timeout"; then
    # A server that never bound is still running and still holds its port
    # block. Stopping it here is what keeps a failed bring-up from leaving one
    # behind per attempt: a harness retrying against a wedged instance would
    # otherwise pile up servers, each owning a world and a userdata tree.
    echo "sb: bring-up failed, stopping the server it started" >&2
    terminate_instance "$inst"
    die "server '$name' did not open port $port in ${timeout}s; check $inst/logs/server.log"
  fi
  # stdout is the contract and nothing else: the documented caller is
  # `eval "$(sb up <name>)"`, which a status line on stdout would break. The
  # progress line a person reads goes to stderr, where it does not collide.
  echo "server '$name' up on port $port (telnet $telnet_port)" >&2
  cmd_env "$name"
}

# Copy built modlets into an instance so a harness does not reach into
# game/Mods itself. Sources are directories containing ModInfo.xml.
cmd_stage() {
  local name="$1"; shift || true
  local inst
  inst="$(instance_dir "$name")"
  stage_mods "$inst" "$@"
}

# Declare serverconfig properties for an instance. The suite or scenario that
# needs a world, a seed or spawn caps states them here rather than shipping its
# own XML rewriter. Declarations are recorded in instance.props and the config
# is rebuilt from the base template, so the result depends only on what is
# declared now, not on what a previous run left behind.
cmd_render_config() {
  local name="$1"; shift || true
  local inst kv
  inst="$(instance_dir "$name")"
  for kv in "$@"; do
    validate_prop "$kv"
  done
  # The port pair is checked before anything is recorded, not after. Rendering
  # needs it, and a hand-edited instance.env that fails the check left the
  # declarations already written to instance.props with no rendered config
  # behind them: the file claimed a world the next launch would then apply,
  # while this call had exited with nothing rendered.
  instance_server_ports "$inst"
  record_server_props "$inst" "$@"
  local port="$SERVER_PORT" telnet_port="$SERVER_TELNET_PORT"
  apply_server_config "$inst" "$name" "$port" "$telnet_port"
  echo "config -> $APPLIED_CONFIG"
}

cmd_run() {
  local mode="$1" name="$2"; shift 2
  validate_name "$name"
  case "$mode" in
    client)
      ensure_instance "$name" cmd_create "$name" >/dev/null
      exec cmd_launch "$name" "$@"
      ;;
    server)
      ensure_instance "$name" cmd_create_server "$name" >/dev/null
      exec cmd_launch_server "$name" "$@"
      ;;
    both)
      # Server first; client joins once the port is up. The stock client
      # ignores -connect=, so auto-join rides the sibling 7dtd-fastconnect
      # mod (reads 7DTD_CONNECT at menu, issues the console connect). Without
      # the sibling repo the client still launches and sits at the menu.
      local srv_name="srv-$name" cli_name="client-$name"
      ensure_instance "$cli_name" cmd_create "$cli_name" >/dev/null
      stage_fastconnect "$INSTANCES_DIR/$cli_name"
      ensure_instance "$srv_name" cmd_create_server "$srv_name" >/dev/null

      local srv_inst="$INSTANCES_DIR/$srv_name"
      instance_server_ports "$srv_inst"
      local srv_port="$SERVER_PORT" srv_telnet_port="$SERVER_TELNET_PORT"

      echo "starting server '$srv_name' (port $srv_port) in background..."
      start_server_detached "$srv_inst" "$srv_name" "$srv_port" "$srv_telnet_port"
      echo "waiting for server port $srv_port ..."
      if ! wait_for_port 127.0.0.1 "$srv_port" "$RUN_BOTH_PORT_WAIT_SEC"; then
        # Same as `sb up`: a server that never bound is stopped, not left
        # holding the port block behind a failed `run both`.
        echo "sb: bring-up failed, stopping the server it started" >&2
        terminate_instance "$srv_inst"
        die "server did not open port $srv_port in ${RUN_BOTH_PORT_WAIT_SEC}s; check $srv_inst/logs/server.log"
      fi
      echo "server up; launching client '$cli_name' with -connect=127.0.0.1:$srv_port"
      # Bash cannot export a name starting with a digit; the connect mod
      # reads the canonical name, so hand it over with env(1). cmd_launch
      # re-resolves it via printenv and passes it to the game the same way
      # launch_client.sh does.
      exec env 7DTD_CONNECT="127.0.0.1:$srv_port" \
        SB_CLIENT_CONNECT="127.0.0.1:$srv_port" \
        bash "$0" launch "$cli_name" -connect="127.0.0.1:$srv_port" "$@"
      ;;
    *) usage_err "unknown mode '$mode' (use client | server | both)" ;;
  esac
}

# --- dispatch --------------------------------------------------------------

main() {
  local cmd="${1:-help}"
  shift || true
  # 'sb <command> --help' prints that command's page, whatever the command
  # would otherwise do with the argument. Checked here rather than in each
  # parser so no verb has to grow the case, and so a flag a verb does not know
  # still reaches the help instead of a bare "unknown option".
  if (($#)) && [[ "$1" == "-h" || "$1" == "--help" ]]; then
    case "$cmd" in
      -h|--help|help|"") usage ;;
      *) usage_for "$cmd" ;;
    esac
    return 0
  fi
  case "$cmd" in
    init) cmd_init ;;
    doctor) cmd_doctor ;;
    fetch-base|fetch) cmd_fetch "${1:-}" ;;
    fetch-server-base) cmd_fetch_server_base "${1:-}" ;;
    run)
      [[ $# -ge 2 ]] || usage_err "usage: sb run <client|server|both> <name> [-- args...]"
      local rmode="$1" rname="$2"; shift 2
      [[ "${1:-}" == "--" ]] && shift
      cmd_run "$rmode" "$rname" "$@"
      ;;
    create)
      [[ $# -ge 1 ]] || usage_err "usage: sb create <name> [--res WxH] [--fullscreen 0|1]"
      local crname="$1"; shift
      cmd_create "$crname" "$@"
      ;;
    create-server)
      [[ $# -ge 1 ]] || usage_err "usage: sb create-server <name> [--admin NAME...]"
      local csname="$1"; shift
      local cadmins=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --admin) shift; [[ $# -gt 0 ]] || usage_err "--admin needs a name"; cadmins+=("$1") ;;
          *) usage_err "unknown create-server option '$1' (--admin NAME)" ;;
        esac
        shift
      done
      cmd_create_server "$csname" "${cadmins[@]+"${cadmins[@]}"}"
      ;;
    up)
      [[ $# -ge 1 ]] || usage_err "usage: sb up <name> [--timeout N]"
      local uname="$1"; shift
      cmd_up "$uname" "$@"
      ;;
    stage)
      [[ $# -ge 2 ]] || usage_err "usage: sb stage <name> <mod-dir> [mod-dir...]"
      local gname="$1"; shift
      cmd_stage "$gname" "$@"
      ;;
    render-config)
      [[ $# -ge 2 ]] || usage_err "usage: sb render-config <name> KEY=VALUE [KEY=VALUE...]"
      local rname="$1"; shift
      cmd_render_config "$rname" "$@"
      ;;
    destroy)
      [[ $# -ge 1 ]] || usage_err "usage: sb destroy <name> [name...]"
      local dn; for dn in "$@"; do cmd_destroy "$dn"; done
      ;;
    wipe)
      [[ $# -ge 1 ]] || usage_err "usage: sb wipe <name> [name...]"
      local wn; for wn in "$@"; do cmd_wipe "$wn"; done
      ;;
    list|ls) cmd_list ;;
    status) [[ $# -ge 1 ]] || usage_err "usage: sb status <name>"; cmd_status "$1" ;;
    launch|run-launch)
      [[ $# -ge 1 ]] || usage_err "usage: sb launch <name> [-- args...]"
      local lname="$1"; shift
      [[ "${1:-}" == "--" ]] && shift
      cmd_launch "$lname" "$@"
      ;;
    launch-server)
      [[ $# -ge 1 ]] || usage_err "usage: sb launch-server <name> [-- args...]"
      local lsname="$1"; shift
      [[ "${1:-}" == "--" ]] && shift
      cmd_launch_server "$lsname" "$@"
      ;;
    stop)
      [[ $# -ge 1 ]] || usage_err "usage: sb stop <name> [name...]"
      local sn; for sn in "$@"; do cmd_stop "$sn"; done
      ;;
    logs) [[ $# -ge 1 ]] || usage_err "usage: sb logs <name> [--follow]"; cmd_logs "$1" "${@:2}" ;;
    env) [[ $# -ge 1 ]] || usage_err "usage: sb env <name>"; cmd_env "$1" ;;
    version|--version|-V) echo "sb $SB_VERSION" ;;
    help|-h|--help|"")
      if (($#)) && [[ "$1" != -h && "$1" != --help ]]; then
        usage_for "$1"
      else
        usage
      fi
      ;;
    *)
      echo "sb: unknown command '$cmd'" >&2
      suggest_command "$cmd"
      exit 2
      ;;
  esac
}

# Installed once, at the top level: bash resets a trapped signal to its
# original disposition inside a subshell, so the rollback `create` and
# `create-server` do in one is unaffected, and `exec`ing the game never reaches
# a handler.
trap sb_settle_pending EXIT
trap 'sb_on_signal INT' INT
trap 'sb_on_signal TERM' TERM
trap 'sb_on_signal HUP' HUP

main "$@"
